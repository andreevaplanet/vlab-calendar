ternal":false,"previouslyConfirmed":true,"initiative":[{"id":60,"value":"EUMETSAT & NMS","visible":false},{"id":50,"value":"EUMETSAT","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":7,"value":"VI Europe"}],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1374,"created":null,"updated":null,"title":"Webinar on access to RapidScat data","titleNative":"Webinar on access to RapidScat data","startDate":1442361600000,"endDate":1442361600000,"tbdDate":"2015/09/16  13:00 UTC","city":"Online","host":"EUMESTAT","contactPerson":"Maja Kuna","contactEmail":"Maja.Kuna@eumetsat.int","contactUrl":"http://mt204.sabameeting.com/main/Customers/fmi/Registrar/NewRegistration.jsp?event_id=0000007efc7434014e51bbbb40007f66&source","description":"EUMETSAT OSI SAF will offer one-day online real-time event about the RapidScat data. \r\n\r\nRapidScat is a short term duration mission, placing a wind scatterometer on the International Space Station (ISS) and is already a success. NOAA/NESDIS and KNMI / OSI-SAF are processing the data to produce wind observations for operational forecasting in near-real time.\r\n\r\nIn this short online session you will hear presentations on how you can access the data, on its characteristics and on experiences of using the data in operational forecasting. The ISS orbit is unusual for wind scatterometers and at latitudes between 40 and 55 degrees, multiple satellite passes will occur twice a day, resulting in much enhanced coverage. Moreover, the unusual orbit results in observation of the diurnal wind cycle and in many collocations with the ASCAT wind scatterometer on MetOp-A and -B, allowing their intercalibration. This brings new insights in the characteristics of scatterometer winds, both of the ASCAT and RapidScat type, leading to better winds.\r\n \r\nAd Stoffelen from KNMI will present the data available from the OSI SAF and elaborates on the research achievements of the RapidScat data.&#8206; Team USA will present experiences on using the data in operational marine analysis and forecasting.\r\n","country":null,"learningOutcome":"","summary":"EUMETSAT OSI SAF will offer one-day online real-time event about the RapidScat data. \r\n\r\nRapidScat is a short term duration mission, placing a wind scatterometer on the Internation","content":"","targetAudience":"Not defined","registrationHowto":"","registrationEndDate":null,"fees":"","awardGranted":null,"creator":{"id":654,"name":"Sara Mesa Sequeira","email":"Sara.MesaSequeira@eumetsat.int","agency":"EUMETSAT","country":"DE","programme":"EUMETSAT","trainingPartner":null,"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":true,"initiative":[{"id":50,"value":"EUMETSAT","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":7,"value":"VI Europe"},{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1393,"created":null,"updated":null,"title":"Caribbean Weather Discussion - 15:30 UTC","titleNative":"Caribbean Weather Discussion - 15:30 UTC","startDate":1442361600000,"endDate":1442361600000,"tbdDate":"","city":"Online","host":"CIMH","contactPerson":"Kathy-Ann Caesar","contactEmail":"kacaesar@cimh.edu.bb","contactUrl":"https://sas.elluminate.com/site/external/launch/meeting.jnlp?sid=voffice&password=M.22B0AD82F90F4410F67CADF193A355","description":"Hello Colleagues\r\n \r\nTh