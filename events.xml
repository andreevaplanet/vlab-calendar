adataGroup":{"id":1,"name":"EUMETSAT"},"id":159,"name":"SAR-C","uniqueName":"SAR-C (Sentinel-1)"}]},{"id":2719,"created":1781163822000,"updated":1781167649000,"title":"EUMeTrain Monthly Weather Briefing","titleNative":"EUMeTrain Monthly Weather Briefing","startDate":1781697600000,"endDate":1781700300000,"tbdDate":null,"city":null,"host":"EUMetrain","contactPerson":"Ana Fazinić","contactEmail":"eumetrain@gmail.com","contactUrl":"https://resources.eumetrain.org/weather_briefings.html","description":"Once a month, EUMeTrain organises an open to all Weather Briefing to discuss the present weather situation. The basis of the discussions are today's satellite images and the corresponding numerical weather prediction data. A basic knowledge on conceptual models used in satellite meteorology is of advantage to follow the presentations.\n\nThis session will be conducted via Webex.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Participants will learn which RGB products to use in a particular weather situation, as well as how to interpret the products and single channels.","summary":"Once a month, EUMeTrain organises an open to all Weather Briefing to discuss the present weather situation. The basis of the discussions are today's satellite images and the corres","content":null,"targetAudience":"The open event could be of interest to forecasters, students and researchers.","registrationHowto":"To join, go to: [https://resources.eumetrain.org/weather_briefings.html](https://resources.eumetrain.org/weather_briefings.html) and follow the instructions.","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":12935,"name":"Ana Fazinic","email":"ana.fazinic@dhz.hr","agency":"","country":"HR","programme":"","trainingPartner":{"id":17,"value":"EuMeTrain"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":9959,"name":"Madalina System Admin Ungur ","email":"madalina.ungur@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":24,"name":"Partners"},"statusUpdate":null,"eventType":{"id":107,"value":"Webinar"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":40,"value":"EUMeTrain","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[{"id":13,"value":"PWS: Public Weather Forecasters"},{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2707,"created":1778588983000,"updated":1778766987000,"title":"Introduction to Fire Products - Expert User Exchange - Part 3","titleNative":"Introduction to Fire Products - Expert User Exchange - Part 3","startDate":1781078400000,"endDate":null,"tbdDate":null,"city":null,"host":"EUMETSAT","contactPerson":"Noemi Marsico","contactEmail":"noemi.marsico@external.eumetsat.int","contactUrl":null,"description":"This short session is the third part of a course on EUMETSAT fire products. It will provide a dedicated space for exchange and discussion around fire-related products and services, helping participants consolidate what has been covered in the previous sessions, and address any remaining questions.\n\nOrganised as a closed user exchange, with a limited number of participants, the session will offer an opportunity for direct interaction between users and experts. Participants will be able to ask questions, share needs, discuss challenges, and better understand how fire products can be accessed and applied in practice.\n\nThe session will follow an open question-and-answer format, and will last 1.5 hours. It will bring together experts from different areas, including atmospheric composition, fire monitoring, data access services, and other relevant domains. This format will allow participants to receive targeted answers, explore practical use cases, and engage in a more informal and interactive discussion on the use of fire-related data and products.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"- Clarify the main applications, use cases, and limitations of EUMETSAT fire products.\n- Improve understanding of the process to access and apply fire-related data in operational contexts.\n- Opportunity to share feedback, user needs, and challenges with EUMETSAT experts and other participants. ","summary":"This short session is the third part of a course on EUMETSAT fire products. It will provide a dedicated space for exchange and discussion around fire-related products and services,","content":null,"targetAudience":"Experts","registrationHowto":"Participation in this event is limited to invited participants only.","registrationEndDate":1780963140000,"fees":"No","awardGranted":null,"creator":{"id":11762,"name":"Noemi Marsico","email":"noemi.marsico@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":9959,"name":"Madalina System Admin Ungur ","email":"madalina.ungur@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":2,"value":"By invitation only"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":8,"external":false,"previouslyConfirmed":false,"initiative":[{"id":50,"value":"EUMETSAT","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":36,"title":"Fires","identifier":"dataApplication"}],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2708,"created":1779977413000,"updated":1780308300000,"title":"Beyond Morpheus - Navigating the new EWC Services ","titleNative":"Beyond Morpheus - Navigating the new EWC Services ","startDate":1781078400000,"endDate":null,"tbdDate":null,"city":null,"host":"ECMWF, EUMETSAT","contactPerson":"","contactEmail":"training@ecmwf.int","contactUrl":"https://events.ecmwf.int/event/564/overview","description":"The European Weather Cloud (EWC) teams at ECMWF and EUMETSAT are pleased to invite you to the second thematic EWC webinar of 2026.\n\nThese recurring thematic webinars are aimed at all users of the EWC service, provided by EUMETSAT and ECMWF, which is available to all ECMWF and EUMETSAT Member and Co-operating States. Our primary objective is to provide guidance to users on how to effectively use the different capabilities of the EWC.\n\nInformation on the previous webinars, including their recordings, can be found [on the ECMWF confluence site](https://confluence.ecmwf.int/display/EWCLOUDKB/EWC+Training+and+Tutorials). \n\nIn this webinar, we will focus on the transition away from Morpheus, which will be phased out at the end of 2026. We will show how users can now perform the same tasks using the new EWC services, including OpenStack Horizon, the EWC Community Hub, and the EWC Identity and Access Management (IAM) service.\n\nBy the end of this session, participants will have a clear understanding of how to carry out the most common activities on the EWC using the new, harmonised set of services available (which will be released in the next months) across both EUMETSAT and ECMWF.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Participants will learn how to:\n\n* Understand how the new services fit together and how the overall user experience differs from the Morpheus‑based workflow.\n* Use OpenStack Web and CLI to perform the key operations that were previously done in Morpheus, such as backups.\n* Use the EWC Community Hub to discover, deploy, and reuse community‑maintained items that replace or improve workflows previously implemented through Morpheus blueprints or instances.\n","summary":"The European Weather Cloud (EWC) teams at ECMWF and EUMETSAT are pleased to invite you to the second thematic EWC webinar of 2026.\n\nThese recurring thematic webinars are aimed at a","content":null,"targetAudience":"","registrationHowto":"This webinar is open to anyone from an ECMWF or EUMETSAT Member and Co-operating State.\n\nIf you would like to attend the webinar, please [complete the registration form](https://events.ecmwf.int/event/564/registrations/436/). We will alert you of your acceptance to the webinar and send you all the joining information and Microsoft Teams meeting details in due course.","registrationEndDate":1781222340000,"fees":"No","awardGranted":null,"creator":{"id":7912,"name":"Niklas Jordan","email":"niklas.jordan@external.eumetsat.int","agency":"EUMETSAT","country":"EM","programme":"EUMETSAT","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":9959,"name":"Madalina System Admin Ungur ","email":"madalina.ungur@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"le