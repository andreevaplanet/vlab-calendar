":17,"value":"EuMeTrain"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":24,"name":"Partners"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":27,"external":false,"previouslyConfirmed":false,"initiative":[{"id":40,"value":"EUMeTrain","visible":true}],"trainingPartner":[{"id":15,"value":"EUMETSAT","visible":false}],"programmes":[],"language":[],"regions":[{"id":7,"value":"VI Europe"}],"qualification":[{"id":13,"value":"PWS: Public Weather Forecasters"},{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2361,"created":1703001880000,"updated":1703004884000,"title":"Virtual Workshop on the Synoptic Analysis of South America: January 23-25, 2024","titleNative":"Taller Virtual de Análisis Sinóptico en Sudamérica: 23-25 de enero de 2024","startDate":1706018400000,"endDate":1706200200000,"tbdDate":null,"city":null,"host":"DMC (Chile), NOAA, CIRA, WMO-CGMS VLab","contactPerson":"Jose Galvez","contactEmail":"jose.galvez@noaa.gov","contactUrl":"https://origin.wpc.ncep.noaa.gov/international/workshops/2024cl/index.html","description":"*Please note that this workshop will be conducted only in Spanish.\n\nLa Oficina de Aplicaciones Satelitales de la Dirección Meteorológica de Chile (DMC) junto a los Escritorios Internacionales del Centro de Predicción del Tiempo, bajo la oficina Nacional de Administración Oceánica y Atmosférica (NOAA) organizan un taller virtual sobre la Metodología de Análisis Sinóptico y Trazado de Frentes. El taller virtual se realizará el 23 - 25 de enero de 2024, de las 11:00am - 13:30pm hora de Chile (14 - 16:30 UTC). El taller incluirá un resumen de la metodología de análisis sinóptico y trazado de frentes, desarrollado por la Dirección Meteorológica de Chile; y a su vez la interpretación de la Carta Sinóptica aplicada a Chile y el sur de Sudamérica. Junto a esto, el taller también incluirá una recapitulación de los conceptos más relevantes de la meteorología sinóptica de latitudes medias, con los cuales se fundamenta esta metodología de análisis. \n\nLos asistentes de este taller virtual participarán por medio de un seminario web, el cual contará con presentaciones, análisis de casos e instancias de discusión, donde habrá oportunidad para conversar y hacer preguntas a los presentadores y el resto de los participantes. Es importante mencionar que este taller se realizará solamente en español y no contará con interpretación simultánea al inglés.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"La metodología de análisis sinóptico y trazado de frentes.","summary":null,"content":null,"targetAudience":"Meteorólogos, pronosticadores y profesionales interesados en el proceso de diagnóstico meteorológico, análisis sinóptico o el trazado de frentes.","registrationHowto":"Register here: https://register.gotowebinar.com/register/3639548850501984091 ","registrationEndDate":1705536000000,"fees":"No","awardGranted":null,"creator":{"id":5874,"name":"Erin Sanders","email":"Erin.Sanders@colostate.edu","agency":"","country":"US","programme":"","trainingPartner":{"id":30,"value":"CIRA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":103,"value":"Workshop"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":90,"value":"VLab","visible":true},{"id":210,"value":"NOAA","visible":true}],"trainingPartner":[{"id":18,"value