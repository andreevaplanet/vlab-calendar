es":"No","awardGranted":null,"creator":{"id":5859,"name":"Jose Galvez","email":"jose.galvez@colostate.edu","agency":"","country":"US","programme":"","trainingPartner":{"id":18,"value":"NOAA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":90,"value":"VLab","visible":true},{"id":210,"value":"NOAA","visible":true}],"trainingPartner":[{"id":12,"value":"VLab Centre of Excellence Costa Rica","visible":false},{"id":18,"value":"NOAA","visible":false},{"id":2,"value":"VLab Centre of Excellence Barbados","visible":false},{"id":3,"value":"VLab Centre of Excellence Argentina","visible":false},{"id":4,"value":"VLab Centre of Excellence Brazil","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":7,"value":"Spanish","iso639":"es"}],"regions":[{"id":3,"value":"III South America"},{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1847,"created":1576916808000,"updated":1578498284000,"title":"Marine Weather Forecasting Course, RAI-Africa (Online phase)","titleNative":"Marine Weather Forecasting Course, RAI-Africa (Online phase)","startDate":1583107200000,"endDate":1584576000000,"tbdDate":null,"city":"","host":"SAWS","contactPerson":"Dr. Winifred Jordaan","contactEmail":"Winifred.Jordaan@weathersa.co.za","contactUrl":"","description":"This is pre-requisite event for face-to-face Marine Weather Forecasting Course. Selected participants of this online phase will be invited to classroom phase, to be held in Pretoria, 22-26 June 2020.\r\n\r\nThe course organised in partnership by NOAA and EUMETSAT will focus on the application of satellite data (scatterometer, altimeter and airmass RGB) to marine wind and wave forecasting. \r\n\r\nThe teaching purpose of the course is to equip marine forecasters and training in marine meteorology with the knowledge and skills to sue wind and wave data in their forecasting or training. The secondary purpose of the course is to better understand the operational realities for marine forecasters in Africa, what training needs there are and the regional capacities to meet those needs. \r\n\r\nSelected participants of this online course will have chance to \r\n\r\nPlease note that the dates indicated for this online course are tentative. ","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"After the course students should be able to: \r\n     -Analyze and monitor continually the marine weather situation.\r\n     -Forecast marine weather phenomena, variables and parameters.\r\n     -Warn of hazardous marine phenomena.","summary":null,"content":"The following skills were trained:\r\n\r\n     1. Interpret satellite imagery and products to identify potentially dangerous phenomena.\r\n     2. Using satellite altimeters and scatterometers.\r\n     3. Use of NWP in waves and swell forecasting.\r\n     4. Identify characteristics of waves and swell.\r\n     5. Monitor sea ice characteristics.\r\n     6. Identify non-routine weather conditions.\r\n     7. Use forecasting model outputs in hazardous conditions.\r\n","targetAudience":"Marine forecasters and trainers in WMO region I (Africa).","registrationHowto":"Invitations will be sent in Q1 2020 to respective institutes within WMO RAI region. In case your institute has not been contacted in recent years, and its activities are related to weather forecasting in the marine environment, WMO RAI, please write to: training@eumetsat.int.","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5845,"name":"Ivan Smiljanic","email":"ivan.smiljanic@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":2,"value":"By invitation only"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":70,"value":"NHMS","visible":true}],"trainingPartner":[{"id":11,"value":"VLab Centre of Excellence South Africa","visible":false},{"id":15,"value":"EUMETSAT","visible":false},{"id":18,"value":"NOAA","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":1,"value":"I Africa"}],"qualification":[{"id":11,"value":"Marine: Marine Weather Forecaster"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1861,"created":1579849750000,"updated":1693586463000,"title":"EUMeTrain Weather Briefing","titleNative":"EUMeTrain Weather Briefing","startDate":1582808400000,"endDate":1582812000000,"tbdDate":null,"city":"","host":"EUMeTrain","contactPerson":"TSO EUMeTrain","contactEmail":"blaskovic@cirus.dhz.hr","contactUrl":"http://eumetrain.org/weather_briefings.html","description":"Hosted by EUMeTrain, weather briefings are monthly online weather discussions about the phenomena that occurred over the past month, since the last weather briefing. Satellite imagery is used to discuss interesting situations and features. Every month the weather briefing is hosted by a different European country.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Gaining know