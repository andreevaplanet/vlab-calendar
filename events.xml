ible":true}],"trainingPartner":[{"id":18,"value":"NOAA","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":3,"value":"III South America"},{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[{"id":6,"value":"BIP-M: Basic Instructional Package for Meteorologists"},{"id":7,"value":"BIP-MT: Basic Instructional Package for Meteorological Technicians"},{"id":15,"value":"Training: Education and Training Providers "},{"id":11,"value":"Marine: Marine Weather Forecaster"},{"id":13,"value":"PWS: Public Weather Forecasters"},{"id":1,"value":"Aviation: Aeronautical Meteorological Forecaster"},{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1913,"created":1595928121000,"updated":1693586463000,"title":"EUMeTrain Weather Briefing","titleNative":"EUMeTrain Weather Briefing","startDate":1598529600000,"endDate":1598533200000,"tbdDate":null,"city":"","host":"EUMeTrain","contactPerson":"TSO EUMeTrain","contactEmail":"blaskovic@cirus.dhz.hr","contactUrl":"http://eumetrain.org/weather_briefings.html","description":"Hosted by EUMeTrain, weather briefings are monthly online weather discussions about the phenomena that occurred over the past month, since the last weather briefing. Satellite imagery is used to discuss interesting situations and features. Every month the weather briefing is hosted by a different European country.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Gaining knowledge about analyzing weather situations using satellite data.\r\nMaintaining a healthy basis of knowledge about satellite meteorology.\r\nUnderstanding the difference between RGBs as well as their benefits and limitations.\r\n","summary":"Hosted by EUMeTrain, weather briefings are monthly online weather discussions about the phenomena that occurred over the past month, since the last weather briefing. Satellite imag","content":"Weather briefings are recorded. Find a collection of past briefings at http://eumetrain.org/briefings.html and on YouTube at https://www.youtube.com/user/eumetrain/videos.","targetAudience":"The primary target audience are forecasters in shifts, although other meteorologists from different areas are also welcome.","registrationHowto":"In order to join the discussion, please go to http://eumetrain.org/weather_briefings.html. For any questions, please use the Contact email.","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5837,"name":"Mark Higgins","email":"mark.higgins@eumetsat.int","agency":"EUMETSAT","country":"EM","programme":"EUMETSAT","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":40,"value":"EUMeTrain","visible":true}],"trainingPartner":[{"id":15,"value":"EUMETSAT","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":7,"value":"VI Europe"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1919,"created":1596647717000,"updated":1599563025000,"title":"Remote Sensing of Coastal Ecosystems","titleNative":"Teledetección de Ecosistemas Costeros","startDate":1598378400000,"endDate":1599591600000,"tbdDate":null,"city":"","host":"NASA ARSET ","contactPerson":"Brock Blevins","contactEmail":"brock.blevins@nasa.gov","contactUrl":"https://go.nasa.gov/3iHVgMV","description":"Coastal and marine ecosystems serve key roles for carbon storage, nutrients and materials cycling, as well as reservoirs of biodiversity. They also provide ecosystems services such as sustenance for millions of people, coastal protection against wave action, and recreational activities. Remote sensing of coastal and marine ecosystems is particularly challenging. Up to 90% of the signal received by the sensors in orbit comes from the atmosphere. Additionally, dissolved and suspended constituents in the water column attenuate most of the light received through absorption or scattering. When it comes to retrieving information about shallow water ecosystems, even in the clearest waters under the clearest skies, less than 10% of the signal originates from the water and its bottom surface. Users, particularly those with little remote sensing experience, stand to benefit from this training covering some of the difficulties associated with remote sensing of coastal ecosystems, particularly beaches and benthic communities such as coral reefs and seagrass.\r\n\r\nRelevant UN Sustainable Development Goals: \r\n- Goal 14: Conserve and sustainably use the oceans, seas and marine resources for sustainable development\r\n- Target 14.2: By 2020, sustainably manage and protect marine and coastal ecosystems to avoid significant adverse impacts, including by strengthening their resilience, and take action for their restoration in order to achieve healthy and productive oceans\r\n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"By the end of this training, attendees will be able to:\r\n\r\n- Identify the different water column components and how they affect the remote sensing signal of shallow-water ecosystems\r\n- Outline existing satellite sensors used for ocean color and shallow-water ecosystem characterization\r\n- Understand the interaction between water constituents, the electromagnetic spectrum, and the remote sensing signal\r\n- Recognize the different processes used to remove the water column attenuation from the remotely-sensed signal to characterize benthic components\r\n- Summarize techniques for characterizing shoreline beach environments with remotely-sensed data and field methods for beach profiling\r\n","summary":null,"content":"Three, 1-hour parts, August 25, September 1, and 8, 2020","targetAudience":"Local, regional, state, federal, and non-governmental environmental managers, researchers, and students.","registrationHowto":"Register Here: https://go.nasa.gov/3iHVgMV","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5861,"name":"Brock Blevins","email":"brock.blevins@nasa.gov","agency":"","country":"US","programme":"","trainingPartner":{"id":25,"value":"NASA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":120,"value":"NASA-ARSET","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":7,"value":"Spanish","iso639":"es"}],"regions":[],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1918,"created":1596647461000,"updated":1599563114000,"title":"Remote Sensing of Coastal Ecosystems","titleNative":"Remote Sensing of Coastal Ecosystems","startDate":1598367600000,"endDate":1599580800000,"tbdDate":null,"city":"","host":"NASA ARSET ","contactPerson":"Brock Blevins","contactEmail":"brock.blevins@nasa.gov","contactUrl":"https://go.nasa.gov/3iKxYGs","description":"Coastal and marine ecosystems serve key roles for carbon storage, nutrients and materials cycling, 