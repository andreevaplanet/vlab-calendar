By invitation only"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":true,"initiative":[{"id":70,"value":"NHMS","visible":true}],"trainingPartner":[{"id":15,"value":"EUMETSAT","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":7,"value":"VI Europe"}],"qualification":[{"id":13,"value":"PWS: Public Weather Forecasters"},{"id":17,"value":"Satellite Skills and Knowledge"},{"id":20,"value":"Other (see description)"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1620,"created":1509715798000,"updated":1521109454000,"title":"Operational Marine Forecasting using EUMETSAT's Copernicus Marine Data Stream - Online Phase","titleNative":"Operational Marine Forecasting using EUMETSAT's Copernicus Marine Data Stream - Online Phase","startDate":1522627200000,"endDate":1523577600000,"tbdDate":null,"city":"","host":"Instituto Português do Mar e da Atmosfera (IPMA)","contactPerson":"Copernicus Training Team","contactEmail":"copernicus.training@eumetsat.int","contactUrl":"","description":"The purpose of the event is to develop skills in using data from EUMETSAT's Copernicus Marine Data Stream for marine weather forecasting to professionals with some previous experience. \r\nWe will focus on the application of data from Sentinel-3, Jason-3 and use of associated data such as EUMETSATs Scatterometers. \r\nThis is a blended course, composed of a 2 weeks online phase and a 5 days face-to-face phase. The online phase will occur from 2 to 13 April 2018 and is mandatory for classroom participants. The classroom phase will deepen the topics discussed during the Online phase. \r\nThe online (asynchronous) component will include recorded lectures, modules, readings and quizzes. This will take two weeks, including approximately 3 hours of individual work per week. The course will finish with a Workshop phase t