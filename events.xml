://learn.bom.gov.au/login/signup.php to create an account. Please include your details including Country of Origin. After signing up you will receive an automated email with a link to confirm your registration within about 15 minutes. If you have not received the confirmation email within this time, check your spam/junk inbox. If there is no confirmation within your spam/junk inbox, contact moodle@bom.gov.au giving their name and email address, stating they had not received their site registration confirmation email for our training site.\r\nC.\tFor users who have already registered, please click \"Continue\" on the Self enrolment (Student) option. Log in using the above Username and Password. If you have forgotten the password then you can use the 'forgot password' function: https://learn.bom.gov.au/login/forgot_password.php\r\nD.\tAustralian Bureau of Meteorology staff please use the 'Bureau staff log in' button to log in to the site. \r\n\r\nPlease use either the Google Chrome or Modzilla Firefox web browsers when you join the session.\r\n","registrationEndDate":null,"fees":"","awardGranted":null,"creator":{"id":5860,"name":"Bodo Zeschke","email":"bodo.zeschke@bom.gov.au","agency":"","country":"AU","programme":"","trainingPartner":{"id":5,"value":"VLab Centre of Excellence Australia"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":90,"value":"VLab","visible":true}],"trainingPartner":[{"id":5,"value":"VLab Centre of Excellence Australia","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":6,"value":"V South-West Pacific"}],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2127,"created":1644334573000,"updated":1644334617000,"title":"Tools for Analyzing NASA Air Quality Model Output","titleNative":"Tools for Analyzing NASA Air Quality Model Output","startDate":1645542000000,"endDate":1646154000000,"tbdDate":null,"city":"","host":"NASA Applied Remote Sensing Training Program (ARSET)","contactPerson":"Brock Blevins","contactEmail":"brock.blevins@nasa.gov","contactUrl":"https://appliedsciences.nasa.gov/join-mission/training/english/tools-analyzing-nasa-air-quality-model-output?utm_source=direct&utm_medium=EUMETSAT-VLAB&utm_campaign=PythonTools-AQ-I-22","description":"This advanced webinar series will build the capacity to apply Python codes and other online tools to read, map, and analyze datasets from NASA Goddard Earth Observing System (GEOS) air quality forecasts as well as products from the second Modern-Era Retrospective analysis for Research and Application (MERRA-2) reanalysis. The training will run three sessions, with each session two hours long. The sessions will include lectures and hands-on activities, including exercises, interacting with web-based and offline python tools, and time to perform analyses.\r\n\r\nRelevant UN Sustainable Development Goals: \r\n\tTarget 3.9: By 2030, substantially reduce the number of deaths and illnesses from hazardous chemicals and air, water and soil pollution and contamination\r\n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"By the end of this series, attendees will be able to:\r\n\r\n\tDownload, map, and subset GEOS outputs using tools developed by the Goddard Earth Sciences Data and Information Services Center (GES DISC)\r\n\tPerform intercomparison and evaluation of analysis and forecast output using Jupyter notebooks\r\n\tPerform air quality assessment using reanalysis and forecasts from GEOS, ground and satellite measurements\r\n","summary":null,"content":"Course Format: Three, 2 hour parts, with Lecture and Hands-on Lab time ","targetAudience":"This training is primarily intended for local, regional, state, federal, and international organizations involved in air quality management and forecasting, and those with an interest in applying remote sensing and global models for air quality applications.","registrationHowto":"Register here for the 3-part series: https://go.nasa.gov/3q0GXYD","registrationEndDate":1646092800000,"fees":"No","awardGranted":null,"creator":{"id":5861,"name":"Brock Blevins","email":"brock.blevins@nasa.gov","agency":"","country":"US","programme":"","trainingPartner":{"id":25,"value":"NASA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":120,"value":"NASA-ARSET","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2124,"created":1643274731000,"updated":1693586463000,"title":"EUMeTrain Weather Briefing","titleNative":"EUMeTrain Weather Briefing","startDate":1645534800000,"endDate":1645538400000,"tbdDate":null,"city":"","host":"EUMeTrain","contactPerson":"TSO EUMeTrain","contactEmail":"blaskovic@cirus.dhz.hr","contactUrl":"http://eumetrain.org/weather_briefings.html","description":"Hosted by EUMeTrain, weather briefings are monthly online weather discussions about the phenomena that occurred over the past month, since the last wea