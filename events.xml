nfo@eumetcal.eu","contactUrl":"https://eumetcal.eu/en/ui#/page/Newsitem73","description":"The field of weather forecasting is moving quickly, with AI-driven methods increasingly coming in from outside meteorology. This has created a mismatch between the background of the forecaster and the methods behind the forecast. In this talk, we will give a basic introduction to Artificial Intelligence (AI) and Machine Learning (ML), with a focus on their applications in weather. The main goal is to provide insight into how these methods work and how one should reason about them, helping to bridge this gap.\n\nThis webinar will be presented by Martin Andrae (Linköping University, Sweden) on 17 December 2025 at 12:00 UTC / 13:00 CET.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":null,"summary":null,"content":null,"targetAudience":null,"registrationHowto":"https://events.teams.microsoft.com/event/2f8f23be-82e0-4e17-bfb6-b8539c2fc634@396b9e20-59c1-4cf1-bc03-d43fd5759427","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5854,"name":"Tomislav Marekovic","email":"marekovic@cirus.dhz.hr","agency":"","country":"HR","programme":"","trainingPartner":{"id":16,"value":"Eumetcal"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":24,"name":"Partners"},"statusUpdate":null,"eventType":{"id":107,"value":"Webinar"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":30,"value":"Eumetcal","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":2,"value":"II Asia"},{"id":3,"value":"III South America"},{"id":6,"value":"V South-West Pacific"},{"id":7,"value":"VI Europe"},{"id":1,"value":"I Africa"},{"id