ed. ","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Users should be able to use the Data Store service to browse, search for, download and eventually subscribe to, collections and products of interest using EUMDAC, as required.\n\nUsers should be able to use the Data Tailor Web Service to customise products to create bespoke data streams that fit their applications, via EUMDAC, as required\n\nUsers should know where to find resources to support the use of the new data access services\n\nUsers should know where to go for further help in using the new data access services","summary":null,"content":null,"targetAudience":"From basic to advanced users","registrationHowto":"Register here: https://eumetsat.zoom.us/webinar/register/WN_8aCsTvEnS365cyiIsCe3pA","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":9985,"name":"Deleted Trainer","email":"deleted.trainer@eumetsat.int","agency":"EUMETSAT","country":"--","programme":"EUMETSAT","trainingPartner":null,"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":18,"external":false,"previouslyConfirmed":false,"initiative":[],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":11,"name":"Data Store"}],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2456,"created":1721387706000,"updated":1721717439000,"title":"Monthly Regional Weather and Climate Forums - March 2024 Weather Briefings for Middle East Region","titleNative":"Monthly Regional Weather and Climate Forums - March 2024 Weather Briefings for Middle East Region","startDate":1710835200000,"endDate":1710838800000,"tbdDate":null,"city":null,"host":null,"contactPerson":"Ibrahim AbdulSalam","contactEmail":"Ibrahim AbdulSalam@caa.gov.om","contactUrl":"","description":"Monthly Regional Weather and Climate Forums- Weather Briefings generally focus on the latest hot topics related to weather and climate in the Middle East Region and the latest updates on satellite earth observations.\n\nThe  March Forum is scheduled for Tuesday, March 19, 2024, from 08:00 to 09:00 UTC, and it will focus on \"Strengthening  Disaster Preparedness: Meteorology Role in Early Warnings and Anticipatory Action\".\n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":null,"summary":null,"content":null,"targetAudience":"•\tMeteorologists & Weather Forecasters\n•\tEnvironment and Atmospheric Scientists\n•\tGeneral users of weather and Satellite Applications","registrationHowto":"To join the upcoming Forum go to: https://coemct.met.gov.om/course/view.php?id=83","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":8109,"name":"Zamzam AL-Rawahi ","email":"Zamzam.Rawahi@caa.gov.om","agency":"","country":"OM","programme":"","trainingPartner":{"id":7,"value":"VLab Centre of Excellence Oman"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":90,"value":"VLab","visible":true}],"trainingPartner":[{"id":15,"value":"EUMETSAT","visible":false},{"id":7,"value":"VLab Centre of Excellence Oman","visible":false}],"programmes":[],"language":[{"id":1,"value":"Arabic","iso639":"ar"}],"regions":[],"qualification":[],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":18,"title":"Weather","identifier":"dataApplication"}],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2439,"created":1720088381000,"updated":null,"title":"Workshop on EO for Hydrology in Africa","titleNative":"Workshop on EO for Hydrology in Africa","startDate":1710831600000,"endDate":1711022400000,"tbdDate":null,"city":"Darmstadt","host":"EUMETSAT","contactPerson":null,"contactEmail":null,"contactUrl":null,"description":"This workshop aims to enhance collaboration between EO data providers and African hydrological\ninstitutions. After consolidating user needs, discussion will focus on a roadmap for strengthening EO\ndata utilization for hydrology in Africa and identifying opportunities to pursue activities such as\ncapacity building, knowledge transfer, and calibration/validation activities.","country":{"id":"DE","name":"GERMANY","region":"RA-VI","type":"Member State"},"learningOutcome":null,"summary":null,"content":null,"targetAudience":null,"registrationHowto":null,"registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5840,"name":"Rosa Ullucci","email":"rosa.ullucci@eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":103,"value":"Workshop"},"attendance":{"id":2,"value":"By invitation only"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"BLENDED","attendeeCount":29,"external":false,"previouslyConfirmed":false,"initiative":[],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":4,"value":"French","iso639":"fr"}],"regions":[],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2390,"created":1707989047000,"updated":1708070532000,"title":"EUMETSAT series of short courses: Monitoring and modelling extreme waves using altimetry","titleNative":"EUMETSAT series of short courses: Monitoring and modelling extreme waves using altimetry","startDate":1710331200000,"endDate":1710338400000,"tbdDate":null,"city":"","host":"EUMETSAT","contactPerson":"Ben Loveday","contactEmail":"training@eumetsat.int","contactUrl":"https://training.eumetsat.int/course/view.php?id=513","description":"This advanced event will focus on the application of satellite altimetry measurements to monitor and forecast extreme waves. It will present some technical background on how significant wave height products are derived from the radar altimeter measurements.\n\nLeading experts will then present the use of satellite wave measurements, from altimeters but also other complementary satellite sources for marine weather applications, including through their use in models. A practical demonstration will show the retrieval of data at EUMETSAT and their use at a basic level.\n\nThe short course will consist of a 2-hour webinar on March 13 (12:00 - 14:00 UTC), which will include a Q&A and feedback session. To support participants in using the data sets and tools we highlight, we will keep the online Q&A platform open for one week following the webinar, responding quickly to any queries posted.\n\nThe webinar will be broken into 5 sections:\n\n* Welcome & introduction (EUMETSAT) (5 min)\n* Measuring waves with altimetry (V. Rosmorduc, CLS) (20 min + 10 min quick questions/answers)\n* Use of satellite data in extreme wave assessment & modelling (A. Dalphinet, Météo France) (20 min + 10 min quick questions/answers)\n* Practical demo on data access & basic use (V. Rosmorduc, CLS) (20 min)\n* Questions on the whole webinar","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Participant will:\n\n* Understand the altimeter significant wave height measurements, and the complementarity of other data sources.\n* Know how to access altimetry data at EUMETSAT.\n* Understand why this is interesting for marine weather models & forecasts (global dataset, extreme & statistics, etc.), and what are the limitations.\n* Learn about recent developments (SAR-altimetry) & their impact on wave height measurements.\n* Know how to extract and use significant wave height.","summary":"This advanced event will focus on the application of satellite altimetry measurements to monitor and forecast extreme waves. It will present some technical background on how signif","content":null,"targetAudience":"* Established and early career wave researchers.\n* Operational weather forecasters.\n* Private and public sector specialists engaged in marine monitoring activities.\n* Previous and current attendees of EUMETSAT Supporting Marine Applications courses who are focussed on altimetry & applications.","registrationHowto":"Please register at this link: https://eumetsat.zoom.us/webinar/register/WN_iSNsv0i-S0aQZU1HAtGrUg ","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5877,"name":"Ben Loveday","email":"Ben.Loveday@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":47,"external":false,"previouslyConfirmed":false,"initiative":[{"id":50,"value":"EUMETSAT","visible":true},{"id":180,"value":"Copernicus","visible":true}],"trainingPartner":[{"id":15,"value":"EUMETSAT","visible":false}],"programmes":[],"language":[{"id":3,"value":"