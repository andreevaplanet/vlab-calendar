],"regions":[{"id":7,"value":"VI Europe"}],"qualification":[],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":27,"title":"Atmospheric phenomena","identifier":"dataApplication"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":21,"title":"Aerosols","identifier":"dataApplication"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":19,"title":"Data Applications","identifier":"dataApplication"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":18,"title":"Weather","identifier":"dataApplication"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":4,"title":"Atmospheric composition","identifier":"dataApplication"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":36,"title":"Fires","identifier":"dataApplication"}],"eumDataAccessTypes":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":11,"name":"Data Store"}],"eumSatelliteMissions":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":8,"name":"Sentinel-3"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":2,"name":"MSG"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":3,"name":"MTG"}],"eumSensors":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":163,"name":"SLSTR","uniqueName":"SLSTR (Sentinel-3)"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":162,"name":"OLCI","uniqueName":"OLCI (Sentinel-3)"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":138,"name":"FCI","uniqueName":"FCI (MTG)"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":137,"name":"SEVIRI","uniqueName":"SEVIRI (MSG)"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":140,"name":"LI","uniqueName":"LI (MTG)"}]},{"id":2730,"created":1785242903000,"updated":null,"title":"1st South American Symposium on Severe Storms (1st SSTS)","titleNative":"I Simpósio Sul-Americano de Tempestades Severas (I SSTS)","startDate":1794182400000,"endDate":1794441600000,"tbdDate":null,"city":"São José dos Campos","host":"INPE","contactPerson":"Diego Souza","contactEmail":"diego.souza@inpe.br","contactUrl":"https://moodle.cptec.inpe.br/course/view.php?id=42 / https://www.gov.br/inpe/pt-br/eventos/i-ssts","description":"South America is recognized as one of the regions in the world where severe convective storms occur most frequently. These storms are characterized by extreme weather phenomena such as large hail, destructive straight-line winds, tornadoes, locally intense rainfall, and frequent lightning activity.\n\nThe 1st South American Symposium on Severe Storms (1st SSTS) will be a scientific and professional event that, for the first time at the continental level, will bring together the scientific and academic community specializing in severe convective storms with professionals from regional, national, and international institutions and organizations, both public and private. These organizations are involved in the monitoring and forecasting of severe storms, as well as in mitigating their socioeconomic impacts across various sectors of society.\n\nIn this context, the primary objective of the 1st SSTS is to provide a collaborative forum for the exchange of theoretical and practical knowledge on severe storms across weather and climate timescales, while fostering resilience to these hazardous phenomena, with a particular emphasis on the South American context.","country":{"id":"BR","name":"BRAZIL","region":"RA-III","type":"Rest of the World"},"learningOutcome":"By the end of the symposium, participants will be able to:\n\n- Discuss the current state of the art in severe storm research, monitoring, and forecasting in South America.\n- Evaluate recent advances in remote sensing, numerical weather prediction, artificial intelligence, and nowcasting techniques for severe storms.\n- Interpret case studies of severe convective storms and assess their meteorological and societal impacts.\n- Exchange best practices for severe weather forecasting, impact-based forecasting, risk communication, and disaster risk reduction.\n- Strengthen collaboration between the scientific community, operational forecasting centers, government agencies, and industry to improve resilience to severe storms in South America.\n- Identify emerging research challenges, technological opportunities, and priorities for advancing severe storm science and operations across the region.","summary":null,"content":null,"targetAudience":"Research staff from research institutes and R&D organizations; faculty members and students from public and private higher education institutions working in Atmospheric and Environmental Sciences or related fields; weather forecasters from national and regional operational forecasting centers; professionals from public and private institutions involved in weather and climate monitoring and forecasting, disaster risk reduction, and emergency response; professionals in civil defense, the electric power, agriculture, aviation and civil and military navigation, insurance, artificial intelligence and applied mathematics, wind engineering, public health, tourism, public policy (social and economic), and technological development; science journalists and professional science communicators; and public decision-makers.","registrationHowto":"https://moodle.cptec.inpe.br/course/view.php?id=42","registrationEndDate":1794268740000,"fees":"Yes","awardGranted":null,"creator":{"id":5864,"name":"Diego Souza","email":"diego.souza@inpe.br","agency":"","country":"BR","programme":"","trainingPartner":{"id":4,"value":"VLab Centre of Excellence Brazil"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":102,"value":"Conference"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"HYBRID","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":265,"value":"VLab Centre of Excellence Brazil","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":5,"value":"Portuguese","iso639":"pt"}],"regions":[{"id":3,"value":"III South America"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2656,"created":1765552205000,"updated":1765807046000,"title":"FMI-EUMETSAT Aviation Forecaster Testbed 2026 - 2","titleNative":"FMI-EUMETSAT Aviation Forecaster Testbed 2026 - 2","startDate":1793610000000,"endDate":1793970000000,"tbdDate":null,"city":"Darmstadt","host":"EUMETSAT","contactPerson":"Natasa Strelec Mahovic","contactEmail":"training@eumetsat.int","contactUrl":"https://classroom.eumetsat.int/course/view.php?id=158","description":"In partnership with the Finnish Meteorological Institute (FMI), EUMETSAT offers testbeds to prepare Aviation Forecasters for using data from EUMETSAT satellite programmes in their operations. The FMI aviation testbeds simulate an on-site operational meteorological forecasting environment, enhancing the skills of aviation forecasters in using EUMETSAT satellite data and products in aviation services. FMI will use the GEOWEB environment to run the training testbed, providing the full suite of typical products from models to observations, including, in particular, satellite-based products on icing potential, fog and low clouds, visibility, turbulence, volcanic ash, lightning, etc. \n\nDuring the testbeds, forecasters first receive theoretical background on the products, then produce on-the-spot forecasts and nowcasts based on selected cases, using a mix of new nowcasting and forecasting tools, followed by a verification and discussion.\n\nParticular focus will be given to the use of MTG-I1 FCI and LI data and products.\n\nThe testbeds are part of the EUMETSAT-led user preparation projects for MTG and EPS-SG.","country":{"id":"DE","name":"GERMANY","region":"RA-VI","type":"Member State"},"learningOutcome":"Enhanced