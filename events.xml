roup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":90,"value":"VLab","visible":true},{"id":210,"value":"NOAA","visible":true}],"trainingPartner":[{"id":12,"value":"VLab Centre of Excellence Costa Rica","visible":false},{"id":18,"value":"NOAA","visible":false},{"id":2,"value":"VLab Centre of Excellence Barbados","visible":false},{"id":3,"value":"VLab Centre of Excellence Argentina","visible":false},{"id":4,"value":"VLab Centre of Excellence Brazil","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":7,"value":"Spanish","iso639":"es"}],"regions":[{"id":3,"value":"III South America"},{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2112,"created":1639511979000,"updated":1639564951000,"title":"Using Earth Observations for Pre- and Post-Fire Monitoring","titleNative":"Using Earth Observations for Pre- and Post-Fire Monitoring","startDate":1642525200000,"endDate":1642708800000,"tbdDate":null,"city":"","host":"NASA Applied Remote Sensing Training Program (ARSET)","contactPerson":"Brock Blevins","contactEmail":"brock.blevins@nasa.gov","contactUrl":"","description":"Record breaking fire seasons, like those we saw in California in 2020, demonstrate how climate change influences the risk and severity of fires on a global scale. Climate change impacts can increase fire frequency, disrupt historical fire regimes, and contribute to increases in fire intensity and burn severity. Therefore, assessments of fire risk and post-fire mapping and monitoring are vital for effective management and decision-making. This training will consist of two sessions with hands-on-exercises and lab time, where participants will complete exercises with instructors online to answer questions as they come up. During the first session, we will review pre-fire risk assessment by investigating land surface variables (e.g., vegetation type and height, fuel regimes, fuel moisture, and topography) and climate variables (e.g., temperature and precipitation). In the second session, we will conduct post-fire mapping of burned area and burn severity using vegetation indices such as the Normalized Burn Ratio (NBR). Methods will include the use of open-source tools, such as Google Earth Engine and NASA-supported platforms such as the SERVIR Global Service Catalog for analyzing imagery.\r\n\r\nRelevant UN Sustainable Development Goals: \r\n\tTarget 13.1: Strengthen resilience and adaptive capacity to climate-related hazards and natural disasters in all countries\r\n\r\n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Learning Objectives: By the end of the training attendees will be able to:\r\n\r\n\tIdentify land cover and climate variables related to wildfire risk\r\n\tAccess and display geospatial wildfire risk data layers \r\n\tCreate a burn severity map using satellite imagery\r\n\tCalculate burned area using satellite imagery\r\n","summary":null,"content":"Course Format: Two, 3-hour parts with hands-on-exercises and lab time. ","targetAudience":"Local, regional, state, federal, and non-governmental organizations involved in land management, fire risk assessment, and post-fire landscape evaluation. Applied scientists and GIS professionals interested in learning how to complete fire-related assessments independently.","registrationHowto":"Register Here: https://go.nasa.gov/3cw7XZm\r\n\r\n","registrationEndDate":1642636800000,"fees":"No","awardGranted":null,"creator":{"id":5861,"name":"Brock Blevins","email":"brock.blevins@nasa.gov","agency":"","country":"US","programm