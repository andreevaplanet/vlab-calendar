":[{"id":40,"value":"EUMeTrain","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[{"id":13,"value":"PWS: Public Weather Forecasters"},{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2729,"created":1785241615000,"updated":1785241643000,"title":"Short Course on Wildfire Data Processing and Visualization","titleNative":"Minicurso: Processamento e Visualização de Dados de Queimadas","startDate":1785324600000,"endDate":1785510000000,"tbdDate":null,"city":"Online","host":"INPE","contactPerson":"Diego Souza","contactEmail":"diego.souza@inpe.br","contactUrl":"https://moodle.cptec.inpe.br/course/view.php?id=44","description":"The course aims to teach participants how to access and analyze fire hotspot and burned area data detected by polar-orbiting and geostationary satellites. The course consists of both theoretical and practical components. The theoretical sessions cover the fundamentals of satellite-based fire hotspot detection, the different types of satellites, the spectral channels used, and burned area mapping. During the practical sessions, participants will use the Python programming language and Google Colab to download, process, visualize, and analyze the data. The practical exercises are based on fire hotspot data processed and freely provided by INPE, as well as burned area data available through the Google Earth Engine (GEE) platform.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"By the end of the course, participants will be able to:\n\n- Automatically retrieve fire hotspot data.\n- Process and analyze fire hotspot data for a selected region.\n- Create static and animated visualizations of fire hotspots.\n- Generate statistical analyses and visualizations of fire hotspot data at monthly and annual time scales.\n- Apply the K-means clustering algorithm to identify the seasonality of fire hotspots.\n- Analyze satellite imagery for the visual identification of burned areas.\n- Use spectral indices for burned area detection.\n- Estimate the extent of burned areas.","summary":null,"content":null,"targetAudience":"Undergraduate and graduate students, as well as professionals in the fields of Meteorology and Environmental Sciences.","registrationHowto":"https://forms.gle/eJqxfEqq44pKeZtVA","registrationEndDate":1785207600000,"fees":"No","awardGranted":null,"creator":{"id":5864,"name":"Diego Souza","email":"diego.souza@inpe.br","agency":"","country":"BR","programme":"","trainingPartner":{"id":4,"value":"VLab Centre of Excellence Brazil"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":265,"value":"VLab Centre of Excellence Brazil","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":5,"value":"Portuguese","iso639":"pt"}],"regions":[{"id":3,"value":"III South America"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2728,"created":1785119520000,"updated":1785131397000,"title":"Australian VLab Centre of Excellence Regional Focus Group meeting, July 2026","titleNative":"Australian VLab Centre of Excellence Regional Focus Group meeting, July 2026","startDate":1785290400000,"endDate":1785294000000,"tbdDate":null,"city":"Melbourne","host":"Australian VLab Centre of Excellence ","contactPerson":"Bodo Zeschke","contactEmail":"bodo.zeschke@bom.gov.au","contactUrl":"https://learn.bom.g