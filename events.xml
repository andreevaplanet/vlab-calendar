104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":90,"value":"VLab","visible":true},{"id":210,"value":"NOAA","visible":true}],"trainingPartner":[{"id":12,"value":"VLab Centre of Excellence Costa Rica","visible":false},{"id":18,"value":"NOAA","visible":false},{"id":2,"value":"VLab Centre of Excellence Barbados","visible":false},{"id":3,"value":"VLab Centre of Excellence Argentina","visible":false},{"id":4,"value":"VLab Centre of Excellence Brazil","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":7,"value":"Spanish","iso639":"es"}],"regions":[{"id":3,"value":"III South America"},{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2100,"created":1637226491000,"updated":1643970163000,"title":"Explore Analysis Ready Data (ARD) with the data cube for atmospheric composition - Series of online short courses","titleNative":"Explore Analysis Ready Data (ARD) with the data cube for atmospheric composition - Series of online short courses","startDate":1645012800000,"endDate":1645020000000,"tbdDate":null,"city":"","host":"EUMETSAT","contactPerson":"","contactEmail":"training@eumetsat.int","contactUrl":"https://training.eumetsat.int/course/view.php?id=437","description":"This course is part of the spring 2022 edition of EUMETSAT series of online short courses on data discovery for weather, oceanography, air quality and climate. More information will be available soon.\r\n\r\nAnalysis Ready Data (ARD) data are Earth Observation data pre-processed for users and ready to analyse. The idea behind ARD is, that a data provider such as EUMETSAT is in general in a better position to do general data pre-processing, e.g. atmospheric correction, cloud masking and re-gridding, than a user. ARD data are typically made available in form of a data cube, which typically is specialised on a specific region or a thematic application. ","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"","summary":null,"content":"This short course introduces you to the Atmospheric Composition Data Cube (ACDC), a data cube prototype for satellite-based data on atmospheric composition. The ACDC makes use of the data tailor API, which allows for an efficient on-demand access to a selection of EUMETSATs data.\r\n\r\nThe short course consists of two parts:\r\n\r\n the first part will a offer high-level introduction to the concept of Analysis Ready Data; what is meant by ARD, the benefits and why it is important for efficient Earth Observation data handling.\r\n\r\n the second part will be a hands-on practical exercise that show you how you can access and process data with the atmosphere data cube and the data tailor API.","targetAudience":"","registrationHowto":"Register in advance for this webinar: https://eumetsat.zoom.us/webinar/register/1516430273183/WN_UmHjM1hYTkC4lxyvL6iDhg \r\nAfter registering, you will receive a confirmation email containing information about joining the webinar.","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":2830,"name":"Madalina Ungur as sysadmin","email":"Madalina.Ungur@eumetsat.int","agency":"EUMETSAT","country":"DE","programme":"","trainingPartner":null,"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":180,"value":"Copernicus","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2126,"created":1643963805000,"updated":1643963963000,"title":"Data Access Services - How to use the new EUMETView","titleNative":"Data Access Services - How to use the new EUMETView","startDate":1644498000000,"endDate":1644501600000,"tbdDate":null,"city":"","host":"","contactPerson":"EUMETSAT Helpdesk ","contactEmail":"ops@eumetsat.int","contactUrl":"https://training.eumetsat.int/course/view.php?id=436","description":"Monthly series of open, online short sessions on the Data Access Services and their usage via GUIs and APIs, answering top questions posted by participants in an open sli.do (event code #data-services, link https://app.sli.do/event/flsdivtc).\r\n\r\nWe encourage you to post your questions in sli.do now so that we can adapt the content of the next session to answer them.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"- Users should be able to use the Data Store service to browse, search for, download and eventually subscribe to, collections and products of interest using both GUI and API, as required.\r\n- Users should be able to use the Data Tailor Web Service to customise products to create bespoke data streams that fit their applications, via both GUI and API, as required\r\n- Users should be able to use the Data Tailor Web Service to customise products to mirror existing processing chains that rely on EUMETCast and/or the Data Centre.\r\n- Users should be able to use the EUMETView OMS GUI to: i) discover layers, ii) craft their own views, iii) manipulate and share views, iv) export data from layers as time series, images and animations, and v) link layers to Data Store collections where appropriate.\r\nIn addition to the above, users should be able to use the EUMETView OMS API to i) discover capabilities, ii) exploit the WMS/WCS/WFS endpoints to construct customised data requests.\r\n- Users should know where to find resources to support the use of the new data access services\r\nUsers should know where to go for further help in using the new data access services.","summary":"Monthly series of open, online short sessions on the Data Access Services and their usage via GUIs and APIs, answering top questions posted by participants in an open sli.do (event","content":"The next scheduled session is on:\r\n\r\nThursday 10 February 2022, 13:00-14:00 UTC\r\nIt will focus on how to use the new EUMETView.\r\n\r\nThe future sessions are planned for:\r\n\r\nFriday 11 March 2022, 13:00-14:00 UTC\r\n\r\nThe sessions are open to all and address a wide range of attendees, from service providers to scientists and forecasters. Each session requires registration via Zoom. A great opportunity to remove any technical challenges in using the Data Access Services GUIs and APIs, and engage users in discussion with EUMETSAT experts and colleagues.","targetAudience":"Anyone interested in using the new Data Access Services, especially users of the Data Centre, CODA/CODAREP (and possibly also EUMETCast).","registrationHowto":"Register in advance for this meeting:\r\nhttps://eumetsat.zoom.us/meeting/register/tZ0pf-uqqDMuEtUfuE9PiPVrdE_gPmqtlpx1 \r\n\r\nAfter registering, you will receive a confirmation email containing information about joining the meeting.","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5840,"name":"Rosa Ullucci","email":"rosa.ullucci@eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"