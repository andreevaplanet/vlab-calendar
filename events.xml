ew about describing the weather situation using satellite imagery.","registrationHowto":"Copy/paste the provided link.","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5837,"name":"Mark Higgins","email":"mark.higgins@eumetsat.int","agency":"EUMETSAT","country":"EM","programme":"EUMETSAT","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":true,"initiative":[{"id":40,"value":"EUMeTrain","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":7,"value":"VI Europe"}],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1573,"created":null,"updated":null,"title":"RFG of Americas and the Caribbean - 15:00 UTC","titleNative":"RFG of Americas and the Caribbean - 15:00 UTC","startDate":1498143600000,"endDate":1498147200000,"tbdDate":null,"city":"Online","host":"NOAA and CoEs: Costa Rica/Barbados/Argentina/Brazil","contactPerson":"Bernie Connell","contactEmail":"bernie.connell@colostate.edu","contactUrl":"https://attendee.gotowebinar.com/register/3395435225066169858","description":"The sessions are bilingual (English and Spanish) and for WMO regions III (South America) and IV (Central America/Caribbean).  Session time is 15:00 UTC, but as usual, it will start 15 minutes earlier (at 14:45 UTC for those who want to check their microphone and voice connection).  VISITview site is used for the images: http://rammb.cira.colostate.edu/visitview/focus.asp  GoToWebinar is used for both images and voice through the Internet.  Register here: https://attendee.gotowebinar.com/register/3395435225066169858","country":null,"learningOutcome":"Satellite imagery and products real-time applications","summary":null,"content":"","targetAudience":"Forecasters, Students, Researchers, Trainers","registrationHowto":"","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5859,"name":"Jose Galvez","email":"jose.galvez@colostate.edu","agency":"","country":"US","programme":"","trainingPartner":{"id":18,"value":"NOAA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":true,"initiative":[{"id":90,"value":"VLab","visible":true}],"trainingPartner":[{"id":12,"value":"VLab Centre of Excellence Costa Rica","visible":false},{"id":18,"value":"NOAA","visible":false},{"id":2,"value":"VLab Centre of Excellence Barbados","visible":false},{"id":3,"value":"VLab Centre of Excellence Argentina","visible":false},{"id":4,"value":"VLab Centre of Excellence Brazil","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":7,"value":"Spanish","iso639":"es"}],"regions":[{"id":3,"value":"III South America"},{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1566,"created":null,"updated":null,"title":"One Earth  One Health Workshop: Contribution of Earth Observation to Public Health Practices","titleNative":"One Earth  One Health Workshop: Contribution of Earth Observation to Public Health Practices","startDate":1498050000000,"endDate":1498080600000,"tbdDate":null,"city":"Montreal","host":"Université du Québec à Montréal (UQAM)","contactPerson":"Hilcéa Ferreira","contactEmail":"ceos.inpe@dpi.inpe.br","contactUrl":"http://ceos.org/meetings/wgcapd-one-earth-one-health-workshop/","description":"The CEOS Working Group on Capacity Building & Data Democracy (WGCapD) is co-organizing the One Earth  One Health Workshop: Contributions of Earth Observations (EO) to Public Health Practices, which will take place during the 2017 Earth Observation Summit in Montreal, Canada, on June 21, 2017. \r\nThis workshop is an invitation to the large remote sensing community to seek the potential contribution from EO to address public health issues with their own field of expertise (technology, applications, methods).The workshop will unfold in three parts. The first part will entail presentations by the national and international communities on current EO applications, tools & solutions for public health issues. The second part will allow participants to discuss different scenarios related to five public health themes (vector, water & air borne diseases, vulnerable human populations, and emergency management). An expert in the field will facilitate the discussion for each scenario and help the participants answer a list of pre-established questions. The third part will be a discussion that will help inform a report regarding the potential new contribution of space-based EO to public health.","country":{"id":"CA","name":"CANADA","region":"RA-IV","type":"Rest of the World"},"learningOutcome":"","summary":null,"content":"The workshop will unfold in three sessions (time shown in EST for local participants): \r\n\r\n9:00 to 12:00  One Earth One Health: Presentations by national and international communities on current EO applications, tools, & solutions for public health issues.\r\n1:00 to 4:00 PM  Problem Solving Using Scenarios: Discussion of different scenarios related to five public health themes (vector, water, & air-borne diseases, vulnerable human populations, and emergency management).\r\n4:00 to 5:30 PM  Discussion on the Scenarios & Upcoming Report: Report preparation on potential EO contributions to public health practices.","targetAudience":"","registrationHowto":"You may attend the entire Workshop in Montreal ( Please see https://crss-sct.ca/conferences/csrs2017/registration/ for Registration information).  Alternatively, Session 1 of the Workshop (13:00AM  16:00PM UTC) will be made freely available to virtual attendees via GoToMeeting.\r\nIf you would like to virtually participate in the first session of this workshop (via GoToMeeting), please fill out and email the form (available at http://ceos.org/document_management/Working_Groups/WGCapD/Meetings/One-Earth-One-Health_Jun2017/Registration_Form_for_Online_Participation.docx) to Hilcéa Ferreira (ceos.inpe@dpi.inpe.br) with CC to Guy Aubé (guy.aube@canada.ca) no later than June 21st.","registrationEndDate":1498006800000,"fees":"","awardGranted":null,"creator":{"id":5852,"name":"Luciane Veeck","email":"lveeck@wmo.int","agency":"","country":"CH","programme":"","trainingPartner":null,"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":103,"value":"Workshop"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":true,"initiative":[{"id":140,"value":"CEOS-WGCapD","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":2,"value":"II Asia"},{"id":3,"value":"III South America"},{"id":6,"value":"V South-West Pacific"},{"id":7,"value":"VI Europe"},{"id":1,"value":"I Africa"},{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[{"id":21,"value":"Not Applicable"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1580,"created":null,"updated":null,"title":"Remote Sensing of Land Indicators for Sustainable Development Goal 15","titleNative":"Remote Sensing of Land Indicators for Sustainable Development Goal 15","startDate":1497978000000,"endDate":1498154400000,"tbdDate":null,"city":"","host":"NASA Applied Remote Sensing Training Program (ARSET)","contactPerson":"Brock Blevins","contactEmail":"brockbl1@umbc.edu","contactUrl":"https://arset.gsfc.nasa.gov/land/webinars/sdg15","description":"The United Nations Sustainable Development Goals (SDGs) are a series of 17 goals set to end global poverty and protect the planet, with the aim of achieving successes by 2030. The SDGs cover topics from global health, climate change, economic inequality, sustainability, poverty, and more. This training will focus on addressing SDG 15, whose focus is to protect, restore and promote sustainable use of terrestrial ecosystems, sustainably manage forests, combat desertification, and halt and reverse land degradation and halt biodiversity loss.\r\n\r\nIn this webinar, participants will learn how to access and apply satellite data relevant to land indicators, such as estimating total forest area and forest change. The webinar will include an overview of the SDGs, as well as an introduction to image classification and change detection. ","country":null,"learningOutcome":"By the end of this training, attendees will be able to:\r\n\r\nDescribe the UN Sustainable Development Goals, particularly Goal 15\r\nAcquire satellite observations of land cover used to assess SDG indicators 15.1.1 and 15.3.1\r\nDevelop a basic understanding of image classification and change detection","summary":null,"content":"Course Format: \r\nThree one-hour sessions\r\nSessions will be held Tuesday, June 20; Wednesday, June 21; and Thursday, June 22\r\nSessions will be offered at both 1:00 p.m. and 10:00 p.m. EDT (UTC-4)","targetAudience":"Regional, state, federal, and international organizations interested in addressing monitoring requirements for the SDGs through the use of remote sensing.","registrationHowto":"There is no cost for the webinar, but you must register through the training's webpage: https://arset.gsfc.nasa.gov/land/webinars/sdg15","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5861,"name":"Brock Blevins","email":"brock.blevins@nasa.gov","agency":"","country":"US","programme":"","trainingPartner":{"id":25,"value":"NASA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":true,"initiative":[{"id":120,"value":"NASA-ARSET","visible":true}],"trainingPartner":[{"id":25,"value":"NASA","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1563,"created":null,"updated":null,"title":"Satellite Data and Product Applications for National Hydrometeorological Services of CIS countries  ","titleNative":"Satellite Data and Product Applications for National Hydrometeorological Services of CIS countries  ","startDate":1496707200000,"endDate":1496966400000,"tbdDate":null,"city":"Moscow","host":"Russian Federal Service for Hydrometeorology and Environmental Monitoring (ROSHYDROMET) and SRC Plan","contactPerson":"","contactEmail":"seminar.planet@yandex.ru","contactUrl":"http://planet.iitp.ru/seminar ","description":"The event will familiarize the participants with capabilities of new-generation meteorological satellites. It highlights the challenges associated with new-generation satellites, and possible solutions. The new capabilities from Meteosat-8 (Indian Ocean Data Coverage) and Electro-L N2 enables the multi-spectral imagery and products be utilized in new regions. The participants will have an opportunity to learn about these capabilities and new applications in theoretical and practical sessions through case studies and demonstrations. The focus of the event will be in Atmospheric, Sea and Land monitoring applications. ","country":{"id":"RU","name":"RUSSIAN FEDERATION","region":"RA-VI","type":"RA-VI"},"learningOutcome":"Skills in using the single channel and multispectral imagery for identifying various atmospheric phenomena, such as convection, dust, fog and low clouds.  \r\nSkills in using satellite products and applications for Nowcasting purposes. \r\nSkills in using satellite products and applications for ocean monitoring. \r\nSkills in using satellite products and applications for land surface analysis. \r\n","summary":"The event will familiarize the participants with capabilities of new-generation meteorological satellites. It highlights the challenges associated with new-generation satellites, a","content":"6 June  overview of current EUMETSAT and Roshydromet activities, introduction of multi-spectral imagery and products from Meteosat-8 (Indian Ocean Data Coverage)\r\n7 June  satellite applications for atmospheric monitoring\r\n8 June  satellite applications for ocean monitoring\r\n9 June  satellite applications for land monitoring \r\n","targetAudience":"The primary audience of the training event is the specialists of National Hydrometeorological Services of CIS countries, who are familiar with satellite data, but not experts on satellite applications (for example, experts on synoptic charts, aviation meteorologists and etc.).\r\nThe secondary audience of the training event is the satellite application experts, who are dealing with satellite data at their routine work. \r\n","registrationHowto":"Please use website of training event: planet.iitp.ru/seminar (in Russian) and e-mail: seminar.planet@yandex.ru for further information. The registration deadline is until 15 April 2017.","registrationEndDate":1492218000000,"fees":"No","awardGranted":null,"creator":{"id":2829,"name":"Joana Betencourt ","email":"Joana.Betencourt@eumetsat.int","agency":"EUMETSAT","country":"DE","programme":"EUMETSAT","trainingPartner":null,"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":true,"initiative":[{"id":50,"value":"EUMETSAT","visible":true}],"trainingPartner":[{"id":15,"value":"EUMETSAT","visible":false},{"id":22,"value":"Roshydromet","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":6,"value":"Russian","iso639":"ru"}],"regions":[{"id":7,"value":"VI Europe"}],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1574,"created":null,"updated":null,"title":"International Training Course on the Application of Meteorological Satellite Products ","titleNative":"&#27668;&#35937;&#21355;&#26143;&#20135;&#21697;&#24212;&#29992;&#22269;&#38469;&#22521;&#35757;&#29677;","startDate":1496620800000,"endDate":1497571200000,"tbdDate":null,"city":"BeiJing","host":"CMATC","contactPerson":"Wang Tingbo","contactEmail":"applycmatc@cma.gov.cn","contactUrl":"No","description":"The course is aimed to enhance the trainees knowledge and skills in the application of meteorological satellite data and products in supporting weather analysis, weather forecasting, environmental monitoring and disaster risk management. In addition to reinforcing the basic theory and practice the participants will also learn the latest developments in the application of meteorological satellite data and products, especially the recently launched FY-4A satellite.","country":{"id":"CN","name":"CHINA","region":"RA-II","type":"Middle East"},"learningOutcome":"After the courses, participants will be able to:\r\n1) apply the basic theory and principles of radiative transfer to the interpretation of\r\nmeteorological satellite imagery and products;\r\n2) access, select, display and manipulate satellite data;\r\n3) carry out weather analysis and forecasting by using meteorological satellite\r\nimagery and data in particular FY-4A;\r\n4) use Satellite Weather Application Platform (SWAP) and Satellite Monitoring\r\nAnalysis Remote-sensing Toolkit (SMART).","summary":null,"content":"The course contents include: \r\n1)\tGeneral introduction to the FY satellites and their application; \r\n2)\tCurrent and future products of geostationary satellite including FY-4A products such as wind profiling radar (WPR), cloud spectral image, lightning image observation,  space weather monitoring;\r\n3)\tSatellite meteorology, the content and characteristics of satellite observation;\r\n4)\tSatellite data reception and handling;\r\n5)\tWeather analysis and forecasting by using meteorological satellite data;\r\n6)\tUser-oriented satellite application platform: SWAP and SMART which will cover laboratory practice for torrential rain and strong convective weather monitoring, wild fire monitoring, and drought monitoring;\r\n7)\tParticipants forum during which the participants would make a presentation regarding the application in satellite meteorology in their own country/region.","targetAudience":"This course is targeted at senior meteorologists engaged in the field of meteorological\r\nsatellite data and products application and senior officials engaged in meteorological\r\nsatellite management who wish to better understand the satellite meteorology.\r\nApplicants are required to work in the national meteorological and/or Hydrological\r\nService (NMHS), especially for the developing countries.","registrationHowto":"1) The nominated candidates are requested to submit the Application Forms and\r\nPassport Copy (necessary) together with evidence of English proficiency (if there\r\nis) to RTC-Beijing for selection and endorsement - Please contact Wang Tingbo at applycmatc@cma.gov.cn for Application Forms.\r\n2) Application shall be submitted and reach RTC-Beijing no later than 24 April 2017\r\nwith a copy to WMO Secretariat.\r\n3) Admission Notices will be issued to the accepted participants by e-mail by the\r\nRTC-Beijing. With the Admission Notices, the participants are requested to go\r\nthrough all the necessary formalities for entering China and bring all the\r\ndocuments (Admission Notices, Health Document, and Application Forms) to\r\nRTC-Beijing.\r\n4) Only accepted applicants that receive the Admission Notices & Invitation\r\nLetters endorsed by RTC-Beijing can participate in the training course.\r\n5) Normally one application from each Developing Country or two applications from\r\neach Least Developed Country are endorsed by the RTC-Beijing for the local\r\nsupport; other accepted applications or their respective governments need cover\r\ntheir accommodation and meals during the training period;","registrationEndDate":1492995600000,"fees":"No","awardGranted":null,"creator":{"id":3298,"name":"Niu Ning","email":"niun@cma.gov.cn","agency":"CMA","country":"CN","programme":"VLab","trainingPartner":{"id":1,"value":"VLab Centre of Excellence China-Beijing"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":true,"initiative":[{"id":90,"value":"VLab","visible":true}],"trainingPartner":[{"id":19,"value":"CMA","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":2,"value":"II Asia"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1579,"created":null,"updated":null,"title":"Advanced Webinar: Methods in Using NASA Remote Sensing for Health Applications","titleNative":"Advanced Webinar: Methods in Using NASA Remote Sensing for Health Applications","startDate":1496325600000,"endDate":1497538800000,"tbdDate":null,"city":"","host":"NASA Applied Remote Sensing Training Program (ARSET)","contactPerson":"Brock Blevins","contactEmail":"brockbl1@umbc.edu","contactUrl":"https://arset.gsfc.nasa.gov/airquality/webinars/adv-health-17","description":"Every year, environmental conditions adversely affect the health of millions of people. Environmental data can be combined with public health information to predict and monitor potentially dangerous environmental health events, such as disease outbreaks, harmful algal blooms, excessive heat, airborne allergens, and low air quality.\r\n\r\nIn this advanced webinar, participants will learn how to access and apply NASA data relevant to public health. The webinar will include a presentation on tools available for evaluating the relationship between environmental conditions and health outcomes, followed by lectures on pollen dispersal and heat stress mitigation. Two homework assignments will give participants an opportunity to review and practice what they have learned during the presentations.","country":null,"learningOutcome":"By the end of the training, participants will be able to: \r\n\r\nUse satellite remote sensing to increase their knowledge in the environmental health research, Complete original homework problem dealing health and environmental satellite data, and Identify which satellite data sources that could be used in their research","summary":null,"content":"Course Format: \r\nThree, one hour sessions\r\nSessions will be held Thursdays, June 1, 8, and 15 at 10 a.m. and 3 p.m. EDT (UTC-4)","targetAudience":"Public health  professionals and decision makers from local, state, federal, and international agencies, NGOS, and the private sector.","registrationHowto":"There is no cost for the webinar, but you must register through the training's webpage: https://arset.gsfc.nasa.gov/airquality/webinars/adv-health-17","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5861,"name":"Brock Blevins","email":"brock.blevins@nasa.gov","agency":"","country":"US","programme":"","trainingPartner":{"id":25,"value":"NASA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":true,"initiative":[{"id":120,"value":"NASA-ARSET","visible":true}],"trainingPartner":[{"id":25,"value":"NASA","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1581,"created":null,"updated":1693586463000,"title":"Weather Briefing Online, May 31, 12 UTC","titleNative":"Weather Briefing Online, May 31, 12 UTC","startDate":1496232000000,"endDate":1496235600000,"tbdDate":