-ad4d-46a4-a95b-309cf8968cfb%40396b9e20-59c1-4cf1-bc03-d43fd5759427","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5854,"name":"Tomislav Marekovic","email":"marekovic@cirus.dhz.hr","agency":"","country":"HR","programme":"","trainingPartner":{"id":16,"value":"Eumetcal"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":24,"name":"Partners"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":30,"value":"Eumetcal","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2474,"created":1726672495000,"updated":1726672538000,"title":"Introduction to Plankton, Aerosol, Cloud, Ocean Ecosystem (PACE) Hyperspectral Observations for Water Quality Monitoring","titleNative":"Introduction to Plankton, Aerosol, Cloud, Ocean Ecosystem (PACE) Hyperspectral Observations for Water Quality Monitoring","startDate":1727272800000,"endDate":1728502200000,"tbdDate":null,"city":null,"host":"NASA Applied Remote Sensing Training Program (ARSET)","contactPerson":"Brock Blevins","contactEmail":"brock.blevins@nasa.gov","contactUrl":"https://go.nasa.gov/3MgVaw4","description":"Water quality monitoring in coastal ocean estuaries and inland lakes is critical for ecosystems and fisheries management and safe drinking water. Remote sensing of water quality parameters has conventionally used data from multispectral sensors (e.g., Aqua-MODIS, Landsat-OLI, Sentinel-3 OLCI, Sentinel-2 MSI) with a limited number of spectral bands. There have been research missions with hyperspectral sensors (e.g., EO-Hyperion, HICO) that have demonstrated that hyperspectral data (bandwidth <10 nm) can capture more detailed information about water surface reflectance and enable the detection of a wide variety of water pollutants. Plankton, Aerosol, Cloud, ocean, Ecosystem (PACE), a new NASA mission, was launched on 8 February 2024. PACE – Ocean Color Instrument (OCI) collects global, hyperspectral observations for water quality monitoring.\n \nThis three-part introductory training will provide an overview of past and current hyperspectral sensors. Specifically, the training will provide information on NASA’s PACE mission, its sensors and data products, webtools to access data, and software for processing hyperspectral data and water quality parameters derived from PACE/OCI. The training will also highlight some advantages and limitations of PACE data. This will be the first ARSET training focusing on the use of hyperspectral data for water quality applications.\n\nRelevant UN Sustainable Development Goals:\n•\tGoal 14: Conserve and sustainably use the oceans, seas and marine resources for sustainable development\n•\tTarget 14.2: By 2020, sustainably manage and protect marine and coastal ecosystems to avoid significant adverse impacts, including by strengthening their resilience, and take action for their restoration in order to achieve healthy and productive oceans\n•\tGoal 6: Ensure availability and sustainable management of water and sanitation for all\n \nCourse Format: Three 1.5-hour parts including Q&A.\n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"By the end of this training attendees will be able to:\n \n1.\tReview the capabilities of past and current hyperspectral missions useful for water quality applications.\n2.\tExamine key characteristics of the new NASA PACE (Plankton, Aerosol, Cloud, ocean, Ecosystem) hyperspectral mission satellite and instruments including their advantages and limitations.\n3.\tAccess, analyze, and visualize PACE level 2 and 3 data for water quality monitoring in selected areas of interest through using SeaDAS and Jupyter Notebook software.\n4.\tAssess the applicability of selected PACE level 2 and 3 water quality parameters to evaluate water quality in large bodies of water.\n","summary":null,"content":null,"targetAudience":"This training is primarily intended for local, state, and federal Water Quality Managers, Fisheries Advisors, Aquaculture Managers, Freshwater and Coastal Ecosystems Managers, and academic researchers working on remote sensing of water quality and biogeochemistry.\n \n","registrationHowto":"To Register: \n•\tEnglish: https://go.nasa.gov/3MgVaw4\n•\tSpanish: https://go.nasa.gov/3SXHSbi\n","registrationEndDate":1728496800000,"fees":"No","awardGranted":null,"creator":{"id":5861,"name":"Brock Blevins","email":"brock.blevins@nasa.gov","agency":"","country":"US","programme":"","trainingPartner":{"id":25,"value":"NASA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":120,"value":"NASA-ARSET","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":7,"value":"Spanish","iso639":"es"}],"regions":[],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":19,"title":"Data Applications","identifier":"dataApplication"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":6,"title":"Marine","identifier":"dataApplication"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":12,"title":"Ocean biogeochemistry","identifier":"dataApplication"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":14,"title":"Water quality","identifier":"dataApplication"}],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2450,"created":1721284151000,"updated":1726030312000,"title":"Monthly Regional Weather and Climate Forums - September 2024 Weather Briefings for Middle East Region","titleNative":"الملتقى الإقليمي الشهري للطقس والمناخ لمنطقة الشرق الأوسط-سبتمبر 2024","startDate":1727247600000,"endDate":1727251200000,"tbdDate":null,"city":null,"host":null,"contactPerson":"Ibrahim AbdulSalam","contactEmail":"IbrahimAbdulSalam@caa.gov.om","contactUrl":" https://coemct.met.gov.om/course/view.php?id=83","description":"Monthly Regional Weather and Climate Forums- Weather Briefings generally focus on the latest hot topics related to weather and climate in the Middle East Region and the latest updates on satellite earth observations.\n\nThe September session is scheduled for Wednesday, September 25, 2024, from 07:00 to 08:00 UTC. This session will focus on \"Weather Patterns in Libya: Thunderstorms and Rainfall in the Southeast\" and it will cover:\n\n•\tAn overview of Libya's general weather and climate.\n\n•\tA detailed examination of recent severe thunderstorms and rainfall in southeastern Libya.\n\n\n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":null,"summary":null,"content":null,"targetAudience":"•\tMeteorologists & Weather Forecasters\n\n•\tEnvironment and Atmospheric Scientists\n\n•\tGeneral users of weather and Satellite Applications","registrationHowto":"To Join the next Forum: https://jitsi.met.gov.om/coemct ","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":8109,"name":"Zamzam AL-Rawahi ","email":"Zamzam.Rawahi@caa.gov.om","agency":"","country":"OM","programme":"","trainingPartner":{"id":7,"value":"VLab Centre of Excellence Oman"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGr