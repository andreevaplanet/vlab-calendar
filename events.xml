value":"VLab Centre of Excellence Brazil","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":7,"value":"Spanish","iso639":"es"}],"regions":[{"id":3,"value":"III South America"},{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2175,"created":1658316798000,"updated":1700665596000,"title":"SEEMET","titleNative":"SEEMET","startDate":1668409200000,"endDate":1668769200000,"tbdDate":null,"city":"Shefayim","host":"Israel Meteorological Service - IMS","contactPerson":"Natasa Strelec Mahovic","contactEmail":"training@eumetsat.int","contactUrl":null,"description":"SEEMET is a regular yearly training initiated and organized by National Meteorological and Hydrological Services of South-East Europe, and supported by EUMETSAT, Eumetcal, EUMeTrain and ECMWF. Training includes using of satellite data and products as well as ECMWF products in forecast operations. \n\nSEEMET 2022 will be a Basic satellite course, extended with contribution from ECMWF. The training will also serve as a user preparation event for Meteosat Third Generation (MTG). The course is targeted to young forecasters or forecasters with less experience in satellite data interpretation. \n\nThe objective of the course is to introduce participants to basics of satellite remote sensing and to increase their skills in satellite image interpretation and use of satellite data, in combination with NWP data, in weather analysis and forecast.  ","country":{"id":"IL","name":"ISRAEL","region":"RA-VI","type":"RA-VI"},"learningOutcome":"Understand the basics of satellite remote sensing and increase skills in satellite image interpretation and use of satellite data, in combination with NWP data, in weather analysis and forecast.\n\nThe topics will cover: \n- Basic remote sensing, satellite channels, introduction to MTG.\n- Identifying cloud types in satellite data and products, cloud microphysics.\n- Introduction to ECMWF products.\n- Identifying synoptic and mesoscale features in satellite images and NWP data, conceptual models.\n- Identifying land surface features.\n- Dust, smoke and aerosols in satellite data.\n","summary":null,"content":null,"targetAudience":"Young forecasters or forecasters with less experience in satellite data interpretation coming from the SE European National meteorological services.","registrationHowto":"Candidates need to come from SE Europe  National Meteorological Services. The applications to this course are based on the nominations by the heads of NMHSs. Please contact your national point of contact for training or the head of National meteorological service for more information on the nomination and application process.","registrationEndDate":1663286400000,"fees":"No","awardGranted":null,"creator":{"id":5847,"name":"Christine Traeger Chatterjee","email":"christine.traeger@eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":2,"value":"By invitation only"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"RESIDENCE","attendeeCount":20,"external":false,"previouslyConfirmed":false,"initiative":[{"id":70,"value":"NHMS","visible":true}],"trainingPartner":[{"id":16,"value":"Eumetcal","visible":false},{"id":17,"value":"EuMeTrain","visible":false},{"id":15,"value":"EUMETSAT","visible":false}],"programmes":[],"language":[],"regions":[{"id":7,"value":"VI Europe"}],"qualification":[],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":26,"title":"Cloud types","identifier":"dataApplicat