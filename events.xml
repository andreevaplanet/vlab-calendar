view.php?id=581 ","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"- Users will know which data are available from EUMETSAT/ Copernicus services\n- Users will be able to independently find resources and guides relative to Atmospheric data within EUMETSAT within the User Portal\n- Users will able to familiarize themselves with EUMETSAT downloading tools such as Data Store/Data Tailor through Web Service and EUMDAC (Jupyter Notebooks)\n- Users will become familiar with visualising fires. ","summary":"During the summer of 2025, Spain has once again faced an intense wildfire season, highlighting the urgent need for accurate and timely monitoring of fire activity. This 1.5-hour tr","content":null,"targetAudience":"From beginners to intermediate","registrationHowto":"https://eumetsat.zoom.us/webinar/register/WN_IniYlHnqRqaCFL6qxElqMg","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":11762,"name":"Noemi Marsico","email":"noemi.marsico@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":9959,"name":"Madalina System Admin Ungur ","email":"madalina.ungur@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":107,"value":"Webinar"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":115,"external":false,"previouslyConfirmed":false,"initiative":[{"id":50,"value":"EUMETSAT","visible":true},{"id":180,"value":"Copernicus","visible":true}],"trainingPartner":[],"programmes":[{"id"