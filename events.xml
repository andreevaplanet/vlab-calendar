-VI","type":"Member State"},"learningOutcome":null,"summary":"EUMETSAT is organising a user workshop on Future Focus - Wildfires. Building on the EUMETSAT user days and previous workshops addressing the usage of Earth Observations for wildfir","content":null,"targetAudience":"As the event covers the full cycle of wildfire management, we seek representatives from a range of concerned organisations, such as:\n- experts on remote sensing and wildfire related science\n- agencies in charge of weather and civil protection warnings\n- downstream data application/service providers supporting mitigation action and wildfire preparedness.","registrationHowto":"Fill out the application form at: https://www.eventsforce.net/eumetsat/frontend/reg/tRegisterEmailNew.csp?pageID=22895&ef_sel_menu=365&eventID=56&tempPersonID=52281","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":9984,"name":"Dominika Leskow-Czyzewska ","email":"Dominika.Leskow-Czyzewska@eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":103,"value":"Workshop"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"BLENDED","attendeeCount":256,"external":false,"previouslyConfirmed":false,"initiative":[{"id":225,"value":"AC SAF","visible":true},{"id":230,"value":"LSA SAF","visible":true},{"id":50,"value":"EUMETSAT","visible":true},{"id":240,"value":"EFFIS","visible":true},{"id":70,"value":"NHMS","visible":true},{"id":180,"value":"Copernicus","visible":true},{"id":100,"value":"WMO","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":7,"value":"VI Europe"}],"qualification":[],"eumDataApplications"