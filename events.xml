ull,"type":"Other"},"learningOutcome":"Knowledge on satellite fire weather products.","summary":null,"content":"Satellites and Models used to address the problem\r\nProducts developed at INPE\r\nData visualization and access\r\n","targetAudience":"Meteorologists and environmental agents of national and regional centers. ","registrationHowto":"Join the meeting at https://www.gotomeet.me/cptec/vlab\r\nNo advance registration required.","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":2842,"name":"Natalia Rudorff","email":"natalia.rudorff@inpe.br","agency":"INPE","country":"BR","programme":"VLab","trainingPartner":{"id":4,"value":"VLab Centre of Excellence Brazil"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":90,"value":"VLab","visible":true}],"trainingPartner":[{"id":23,"value":"INPE","visible":false},{"id":4,"value":"VLab Centre of Excellence Brazil","visible":false}],"programmes":[],"language":[{"id":5,"value":"Portuguese","iso639":"pt"}],"regions":[{"id":3,"value":"III South America"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1914,"created":1596189651000,"updated":null,"title":"NASA PACE Applications Workshop: Leveraging Science to Advance Society","titleNative":"NASA PACE Applications Workshop: Leveraging Science to Advance Society","startDate":1600819200000,"endDate":1600905600000,"tbdDate":null,"city":"Online","host":"NASA","contactPerson":"http://www.cvent.com/events/2020-pace-applications-workshop/contactus-ea3747f7e68b4c96a319ba6fcdc215","contactEmail":"http://www.cvent.com/events/2020-pace-applications-workshop/contactus-ea3747f7e68b4c96a319ba6fcdc215","contactUrl":"http://www.cvent.com/events/2020-pace-applications-workshop/event-summary-ea3747f7e68b4c96a319ba6fcdc2152a.aspx","description":"The Plankton, Aerosol, Cloud, ocean Ecosystem (PACE) mission is NASA's next great investment in Earth Science. PACE will advance our Earth-observing and monitoring capabilities through hyper-spectral imaging and multi-angle polarimetric observations of the coupled ocean, atmosphere, and land ecosystems. \r\n\r\nThe PACE Mission Applications Programs first annual workshop will be on September 23rd & 24th, 2020. This 2-day virtual workshop will showcase future uses of PACE satellite data and products to support decision-making for water resource management, air quality and health monitoring, climate modeling, disasters response and mitigation, and ecological forecasting.  \r\n\r\nThe workshop will encourage open collaboration across disciplines engaging individuals and organizations, including universities, government agencies, and commercial, non-profit, and private sectors.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Learn about the PACE mission and satellite data and products to support decision-making for water resource management, air quality and health monitoring, climate modeling, disasters response and mitigation, and ecological forecasting.  ","summary":null,"content":"Workshop Highlights:\r\n\tKeynote presentations by Dr. Blake Schaeffer (US EPA), Dr. Stephanie Schollaert Uz (NASA), and Dr. Karl Bates (Duke University)\r\n\tLive plenary panel sessions and informal Q&As with industry professionals, PACE Early Adopter Members, and PACE Scientists & Researchers\r\n\tA library of PACE resources and presentations from the PACE Research Community\r\n\tBreakout discussion groups targeting Stakeholder Engagement, Applied Research Needs, and PACE Science Focus Areas\r\n\tNetworking opportunities and community-building sessions\r\n","targetAudience":"The workshop targets participants interested in applying PACE data for resource management, decision-making, public health applications, and policy analysis. This workshop will encourage open collaboration from individuals and organizations from diverse backgrounds including universities, government agencies, and commercial, non-profit, and private sectors.","registrationHowto":"Register here: http://www.cvent.com/events/2020-pace-applications-workshop/event-summary-ea3747f7e68b4c96a319ba6fcdc2152a.aspx","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5850,"name":"Hayley Evers-King","email":"Hayley.EversKing@eumetsat.int","agency":"","country":"DE","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":103,"value":"Workshop"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":110,"value":"NASA","visible":true}],"trainingPartner":[{"id":15,"value":"EUMETSAT","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":1910,"created":1594419056000,"updated":1594650417000,"title":"RFG of Americas and the Caribbean - 15:00 UTC","titleNative":"RFG of Americas and the Caribbean - 15:00 UTC","startDate":1600268400000,"endDate":1600272000000,"tbdDate":null,"city":"Online","host":"NOAA, CIRA, and CoEs: Costa Rica/Barbados/Argentina/Brazil","contactPerson":"Bernie Connell","contactEmail":"bernie.connell