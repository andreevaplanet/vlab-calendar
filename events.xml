ta. ","content":null,"targetAudience":"The open event could be of interest to forecasters, students and researchers.","registrationHowto":"To join, go to: [https://resources.eumetrain.org/weather_briefings.html](https://resources.eumetrain.org/weather_briefings.html) and follow the instructions.","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":12935,"name":"Ana Fazinic","email":"ana.fazinic@dhz.hr","agency":"","country":"HR","programme":"","trainingPartner":{"id":17,"value":"EuMeTrain"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":9959,"name":"Madalina System Admin Ungur ","email":"madalina.ungur@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":24,"name":"Partners"},"statusUpdate":null,"eventType":{"id":107,"value":"Webinar"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":40,"value":"EUMeTrain","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[{"id":13,"value":"PWS: Public Weather Forecasters"},{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2731,"created":1785243737000,"updated":null,"title":"Nowcasting Course Series 2026","titleNative":"Nowcasting: Série de Cursos 2026","startDate":1786363200000,"endDate":1786735800000,"tbdDate":null,"city":"Cachoeira Paulista","host":"INPE","contactPerson":"Diego Souza","contactEmail":"diego.souza@inpe.br","contactUrl":"https://moodle.cptec.inpe.br/course/view.php?id=43","description":"To strengthen the culture of monitoring extreme weather events in Brazil, INPE organizes the Nowcasting Workshops annually. The objective is to train operational meteorologists from civil defense agencies, state and regional meteorological centers, and the private sector in nowcasting—the science of very short-range weather forecasting, which is essential for issuing timely weather watches and warnings.\n\nHeld at the CPTEC-INPE facilities in Cachoeira Paulista, São Paulo, the workshops have successfully completed three editions. As a practical outcome, dozens of professionals have been trained and are now equipped to apply state-of-the-art technologies for monitoring severe weather events and supporting operational decision-making.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"By the end of the course, participants will be able to:\n\n- Apply the principles of nowcasting to support very short-range weather forecasting and the timely issuance of severe weather watches and warnings.\n- Assess the pre-convective environment using sounding data, numerical weather prediction products, and ingredient-based forecasting techniques.\n- Interpret satellite imagery from the GOES ABI instrument to identify convective initiation, storm evolution, and severe weather signatures.\n- Analyze lightning observations, including GLM products, to monitor convective development and assess storm intensity.\n- Interpret weather radar products, including Doppler and dual-polarization data, to detect and monitor severe convective storms.\n- Estimate precipitation and identify radar signatures associated with hazardous weather phenomena.\n- Integrate information from numerical weather prediction models, satellite observations, lightning detection systems, and weather radar into a comprehensive nowcasting workflow.\n- Apply advanced operational tools and techniques through real-world case studies to support decision-making during high-impact weather events.","summary":null,"content":null,"targetAudience":"Operational meteorologists from civil defense agencies, state and regional meteorological centers, and the private sector. The workshop is intended for professionals and graduate students with a degree in Meteorology or Atmospheric Sciences, or equivalent background, seeking advanced training in nowcasting and severe weather monitoring.","registrationHowto":"https://moodle.cptec.inpe.br/course/view.php?id=43","registrationEndDate":1785542340000,"fees":"Yes","awardGranted":null,"creator":{"id":5864,"name":"Diego Souza","email":"diego.souza@inpe.br","agency":"","country":"BR","programme":"","trainingPartner":{"id":4,"value":"VLab Centre of Excellence Brazil"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"BLENDED","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":265,"value":"VLab Centre of Excellence Brazil","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":5,"value":"Portuguese","iso639":"pt"}],"regions":[{"id":3,"value":"III South America"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2727,"created":1784029422000,"updated":1784033470000,"title":"EUMeTrain Monthly Weather Briefing","titleNative":"EUMeTrain Monthly Weather Briefing","startDate":1785499200000,"endDate":1785501900000,"tbdDate":null,"city":null,"host":"EUMetrain","contactPerson":"Ana Fazinić","contactEmail":"eumetrain@gmail.com","contactUrl":"https://resources.eumetrain.org/weather_briefings.html","description":"Once a month, EUMeTrain organises an