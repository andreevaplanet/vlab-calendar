 and CoEs: Costa Rica/Barbados/Argentina/Brazil","contactPerson":"Erin Sanders","contactEmail":"Erin.Sanders@colostate.edu","contactUrl":"https://rammb.cira.colostate.edu/training/rmtc/focusgroup/","description":"The monthly weather and climate discussions are bilingual (English and Spanish) and focus on WMO regions III (South America) and IV (Central America/Caribbean). The sessions highlight the use and interpretation of satellite imagery and products for meteorological applications, using SLIDER (http://rammb-slider.cira.colostate.edu) for imagery. Anyone with an interest is welcome to attend.\n\nGoToWebinar is the software platform used. The session will begin at 15:00 UTC, with the webinar opening 10 minutes earlier (14:50 UTC) for those who wish to check their microphone.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Satellite imagery and products real-time applications","summary":null,"content":null,"targetAudience":"Forecasters, Students, Researchers, Trainers","registrationHowto":"Register here: https://attendee.gotowebinar.com/register/8619543792122580575\n","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5874,"name":"Erin Sanders","email":"Erin.Sanders@colostate.edu","agency":"","country":"US","programme":"","trainingPartner":{"id":30,"value":"CIRA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":5857,"name":"Zoya Andreeva","email":"zandreeva@wmo.int","agency":"","country":"CH","programme":"","trainingPartner":{"id":29,"value":"WMO"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,