Date":1741773600000,"tbdDate":null,"city":null,"host":"EUMETSAT & ECMWF","contactPerson":"Training Team","contactEmail":"training@eumetsat.int","contactUrl":null,"description":"The European Weather Cloud (EWC) teams at ECMWF and EUMETSAT are pleased to invite you to the first thematic EWC webinar of 2025.\n\nThese recurring thematic webinars are aimed at new or prospective users of the EWC service, provided by EUMETSAT and ECMWF, which is available to all ECMWF and EUMETSAT Member and Co-operating States. Our primary objective is to provide guidance to users on how to effectively use the different capabilities of the EWC.\n\nIn this webinar, we focus on how to access Openstack API using Openstack Application Credentials in EWC. This recently announced feature addresses the needs of use cases requiring process automation and supports Infrastructure as Code (IaC) implementations.\n\nBy the end of this 1-hour session, participants will have gained a better understanding of how to access the service, its basic features and how to use some of the most common commands of the Openstack command line interface including how to create a new server.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":null,"summary":"The European Weather Cloud (EWC) teams at ECMWF and EUMETSAT are pleased to invite you to the first thematic EWC webinar of 2025.\n\nThese recurring thematic webinars are aimed at ne","content":null,"targetAudience":"The main target audience of this webinar are existing and prospective tenancy administrators as well Computing Representatives; however the webinar remains open to anyone interested from an ECMWF or EUMETSAT Member and Co-operating State","registrationHowto":"Apply here: https://events.ecmwf.int/event/459/registrations/321/","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":11305,"name":"Uroosa Farooq ","email":"uroosa.farooq@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":5840,"name":"Rosa Ullucci","email":"rosa.ullucci@eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":null,"attendance":null,"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":50,"value":"EUMETSAT","visible":true},{"id":221,"value":"ECMWF","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":21,"name":"European Weather Cloud"}],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2535,"created":1741274445000,"updated":1741274504000,"title":"Landslide Monitoring and Risk Assessment Using NASA Earth System Data. ","titleNative":"Landslide Monitoring and Risk Assessment Using NASA Earth System Data. ","startDate":1741701600000,"endDate":1742311800000,"tbdDate":null,"city":null,"host":"NASA Applied Remote Sensing Training Program (ARSET)","contactPerson":"Brock Blevins","contactEmail":"brock.blevins@nasa.gov","contactUrl":"https://go.nasa.gov/413Yfrt","description":"This three-part introductory training will cover a number of topics relating to landslides, demonstrating a wide variety of NASA Earth science data uses to characterize landslides and their impacts. The training will provide the scientific background of landslides to answer important questions such as: What is a landslide? Where do they occur? What causes them, and why?\n\nParticipants will learn how satellite-based Earth observations can inform landslide science and disaster planning with a focus on key observations and model data, including optical and synthetic aperture radar (SAR) based analysis. The training will include how NASA data and models can be used to automate landslide detection to rapidly map where landslides have occurred post-disaster using the NASA SALaD model (Semi-Automatic Landslide Detection). The training will also cover how satellite-based Earth observations can better predict the location and timing of landslides using the global LHASA model (Landslide Hazard Assessment model for Situational Awareness). These open-source tools can help communities prepare for and respond to landslides all over the world. \n\nCourse Format: Three 1.5-hour sessions including Q&A.\n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"\tIdentify the core concepts of landslide risk mapping including geophysical and meteorological drivers, and how satellite data can be used for this purpose. \n\tSelect appropriate satellite data and model data to support landslide science and disaster preparedness associated with landslides.\n\tRecognize how to map where landslides have occurred using optical data and understand how automated tools can be used for this purpose.\n","summary":null,"content":null,"targetAudience":"\nThis training is primarily intended for remote sensing scientists and geospatial analysts from local, regional, federal, and non-governmental organizations to use remote sensing for landslide monitoring and risk assessment. This training may also be of interest for academics and researchers interested in remote sensing of natural hazards.\n","registrationHowto":"Time: 10:00 -11:30 or 14:00-15:30 EDT (UTC-4); There will be identical sessions at two different times of the day. Participants need only to register and attend one daily session.\n \nTo Register: https://go.nasa.gov/413Yfrt  \n","registrationEndDate":1742306400000,"fees":"No","awardGranted":null,"creator":{"id":5861,"name":"Brock Blevins","email":"brock.blevins@nasa.gov","agency":"","country":"US","programme":"","trainingPartner":{"id":25,"value":"NASA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":5857,"name":"Zoya Andreeva","email":"zandreeva@wmo.int","agency":"","country":"CH","programme":"","trainingPartner":{"id":29,"value":"WMO"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":120,"value":"NASA-ARSET","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":16,"title":"Emergency","identifier":"dataApplication"}],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2528,"created":1738872740000,"updated":1738873157000,"title":"Calculating Spectral Indices for Land and Aquatic Applications Using QGIS","titleNative":"Calculating Spectral Indices for Land and Aquatic Applications Using QGIS","startDate":1740668400000,"endDate":1740688200000,"tbdDate":null,"city":null,"host":"NASA Applied Remote Sensing Training Program (ARSET)","contactPerson":"Brock Blevins","contactEmail":"brock.blevins@nasa.gov","contactUrl":"https://appliedsciences.nasa.gov/get-involved/training/english/arset-calculating-spectral-indices-land-and-aquatic-applications","description":"This training will provide an overview of spectral indices for land and aquatic applications as they are calculated with a QGIS platform. Specifically, this training will begin with an introduction to the Normalized Difference Vegetation Index (NDVI), along with its calculation, uses, and applications in diverse thematic areas (agriculture, disasters, etc.). We will review additional land-based indices such as the Enhanced Vegetation Index (EVI), Soil-Adjusted Vegetation Index (SAVI), and Normalized Burn Ratio (NBR). Finally, we will concentrate on spectral indices primarily used in aquatic ecosystems, such as the Normalized Difference Chlorophyll Index (NDCI), Normalized Difference Aquatic Vegetation Index (NDAVI), Floating Algal Index (FAI), and Normalized Difference Turbidity Index (NDTI) for aquatic applications. Not only will these sessions discuss the correct circumstances under which to use these indices, but participants will also take part in hands-on indices calculation over relevant study areas. Case studies using indices for land and aquatic applications will be highlighted.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":": By the end of this training attendees will be able to:\n1.\tDescribe data sources, data processing, and applications for indices related to land and aquatic environments.\n2.\tCalculate indices related to environmental monitoring in both land and aquatic systems using the QGIS raster calculator tool.\n3.\tIdentify which indices are appropriate for land versus aquatic monitoring.\n","summary":null,"content":null,"targetAudience":"This training is primarily intended for Technicians and Land/Resource Managers along with students in geography, ecology, and other Earth-observing fields.","registrationHowto":"To Register: \n•\tEnglish: 11:00-12:30 EST (UTC-5): https://appliedsciences.nasa.gov/get-involved/training/english/arset-calculating-spectral-indices-land-and-aquatic-applications\n•\tSpanish: 14:00-15:30 EST (UTC-5): https://appliedsciences.nasa.gov/es/get-involved/training/spanish/arset-el-calculo-de-indices-espectrales-para-aplicaciones-para\n","registrationEndDate":1740668400000,"fees":"No","awardGranted":null,"creator":{"id":5861,"name":"Brock Blevins","email":"brock.blevins@nasa.gov","agency":"","country":"US","programme":"","trainingPartner":{"id":25,"value":"NASA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":5857,"name":"Zoya Andreeva","email":"zandreeva@wmo.int","agency":"","country":"CH","programme":"","trainingPartner":{"id":29,"value":"WMO"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":120,"value":"NASA-ARSET","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":7,"value":"Spanish","iso639":"es"}],"regions":[],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":19,"title":"Data Applications","identifier":"dataApplication"}],"eumDataAccessTypes":[],"eumSatelliteMissions":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":42,"name":"Landsat"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":17,"name":"Aqua/Terra"}],"eumSensors":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":189,"name":"VIIRS","uniqueName":"VIIRS (JPSS)"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":46,"name":"MODIS","uniqueName":"MODIS (Aqua/Terra)"}]},{"id":2575,"created":1750837284000,"updated":1750837843000,"title":"Monthly Form for Weather and Climate in Middle East and North Afr