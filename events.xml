":{"id":24,"name":"Partners"},"statusUpdate":null,"eventType":null,"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":null,"attendeeCount":16,"external":false,"previouslyConfirmed":false,"initiative":[{"id":50,"value":"EUMETSAT","visible":true},{"id":100,"value":"WMO","visible":true}],"trainingPartner":[{"id":15,"value":"EUMETSAT","visible":false}],"programmes":[],"language":[],"regions":[],"qualification":[],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":39,"title":"Climate system monitoring - Terrestrial","identifier":"dataApplication"}],"eumDataAccessTypes":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":18,"name":"SAF archive"}],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2195,"created":1664373867000,"updated":1700665820000,"title":"User Preparation Webinar: Next-generation Copernicus Sentinel-4 and Sentinel-5 Atmospheric Composition Missions","titleNative":"User Preparation Webinar: Next-generation Copernicus Sentinel-4 and Sentinel-5 Atmospheric Composition Missions","startDate":1667480400000,"endDate":1667574000000,"tbdDate":null,"city":null,"host":"EUMETSAT","contactPerson":"Stephan Bojinski","contactEmail":"training@eumetsat.int","contactUrl":"https://www.eumetsat.int/user-preparation-webinar-copernicus-sentinel-4-and-5-atmospheric-composition-missions","description":"The webinar provides:\n•\tan overview of instrument and measurement principles;\n•\tdetails on product generation, product characteristics, and expected performance;\n•\tuser-relevant information about data formats, test datasets, dissemination, and\n•\tapplication perspectives for atmospheric composition and air quality monitoring.\n\nUshering in a new era of monitoring atmospheric composition and air quality from space, the event describes the Sentinel-4 and -5 observation missions, their spectral channels and improvements in resolution and performance over heritage sensors such as GOME-2 and Sentinel-5P/TROPOMI. \n\nSpeakers will address new products from EUMETSAT Central Facility and the Atmospheric Composition Satellite Application Facility, and their expected benefit for the Copernicus Atmosphere Monitoring Service (CAMS). \n\nData from the geostationary Copernicus Sentinel-4/UVN mission on the MTG-S satellite are expected to become available in late 2024, and from the Copernicus Sentinel-5/UVNS mission on the Metop-SG B satellite in 2025.\nThe Q&A session is on www.slido.com, event code #NG-S4S5.\n\nThe agenda is available under this link: https://www.eumetsat.int/user-preparation-webinar-copernicus-sentinel-4-and-5-atmospheric-composition-missions","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"With the User Preparation Webinars, EUMETSAT aims to raise technical and scientific awareness among users, trigger software and algorithm developments for exploiting products, and stimulate the development of applications.","summary":"The webinar provides:\n•\tan overview of instrument and measurement principles;\n•\tdetails on product generation, product characteristics, and expected performance;\n•\tuser-relevant in","content":null,"targetAudience":null,"registrationHowto":"Register and join the webinar using zoom here: https://eumetsat.zoom.us/webinar/register/WN_9s69LIDeTlacrLiVnbXyMw\n","registrationEndDate":1667480400000,"fees":"No","awardGranted":null,"creator":{"id":5841,"name":"Regina Hoefenmayer","email":"regina.hoefenmayer@eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":103,"value":"Workshop"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":53,"external":false,"previouslyConfirmed":false,"initiative":[{"id":50,"value":"EUMETSAT","visible":true},{"id":180,"value":"Copernicus","visible":true}],"trainingPartner":[{"id":15,"value":"EUMETSAT","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":4,"title":"Atmospheric composition","identifier":"dataApplication"}],"eumDataAccessTypes":[],"eumSatelliteMissions":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":11,"name":"Metop-SG"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":3,"name":"MTG"}],"eumSensors":[]},{"id":2133,"created":1645728137000,"updated":1700654630000,"title":"Supporting Marine Earth Observation Applications","titleNative":"Supporting Marine Earth Observation Applications","startDate":1667174400000,"endDate":1669334400000,"tbdDate":null,"city":"","host":"OSI SAF, National and Kapodistrian University of Athens","contactPerson":"Ben Loveday","contactEmail":"copernicus.training@eumetsat.int","contactUrl":"https://training.eumetsat.int/course/view.php?id=158","description":"EUMETSAT and the Oceanography & Earth Observation Group of the National and Kapodistrian University of Athens are jointly organizing the training course “Supporting Marine Earth Observation Applications (SMA)”. In this course participants will learn how to independently access and process data from the EUMETSAT product catalogue for their marine workflows and applications. The focus will be on data streams from EUMETSAT Copernicus marine missions (Sentinel-3; Sentinel-6) and derived downstream products, those derived from Copernicus supporting missions, and those made available by the Ocean and Sea-Ice Satellite Application Facility (OSI SAF).\n\nTraining will take place entirely online and through two phases.\n1. The first, self-paced phase will take place between 31 October and 18 November 2022 and will take approximately 9-15 hours in total to complete. It will involve self-paced flexible learning through webinars, forums and technical checks (particularly for software installations), documentation and assignments.\n\n2. The second, virtual classroom phase will be take place between 21 and 25 November 2022 using Zoom and other collaborative tools. This phase will be made up of interactive tutorials, live demos, group work, and 1:1 meetings. During this intensive week, which will require 5-7 hours of participation each day, we will focus on co-creating a mini-project directly relevant to the participant's application of interest.\n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Participants completing this course will:\n\n- be aware of the operational role EUMETSAT plays in marine Earth observation, understand the range of products it provides and appreciate the role it plays in supporting downstream services\n- be able to select and download the appropriate data for their marine application of interest\n- be able to manipulate these products for their own purposes using appropriate software packages and scripting approaches\n- produce a use case specific to their needs, in collaboration with other participants and trainers.\n","summary":"EUMETSAT and the Oceanography & Earth Observation Group of the National and Kapodistrian University of Athens are jointly organizing the training course “Supporting Marine Earth Ob","content":"","targetAudience":"This workshop is a technical training event, designed to increase the ability of all attending to access and use EUMETSAT marine products for their own applications. Training is aimed at, but not restricted to;\n\n- Early career researchers (masters, PhD, PostDoc) who are new to marine remote sensing and/or the EUMETSAT marine product catalogue\n- Marine scientists who may be working in a cross-disciplinary capacity and are looking to widen their skills into the marine Earth observation\n- Experienced professionals from any relevant sector (industry, government, environment, research) who have clear motivations for working with satellite-based ocean observation data for marine applications.\n","registrationHowto":"Visit the “Apply for courses” section of our Moodle at https://training.eumetsat.int/course/view.php?id=158.","registrationEndDate":1663200000000,"fees":"No","awardGranted":null,"creator":{"id":5877,"name":"Ben Loveday","email":"Ben.Loveday@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":38,"external":false,"previouslyConfirmed":false,"initiative":[{"id":50,"value":"EUMETSAT","visible":true},{"id":180,"value":"Copernicus","visible":true}],"trainingPartner":[{"id":15,"value":"EUMETSAT","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":6,"title":"Marine","identifier":"dataApplication"}],"eumDataAccessTypes":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":11,"name":"Data Store"}],"eumSatelliteMissions":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":9,"name":"Sentinel-6"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":8,"name":"Sentinel-3"}],"eumSensors":[]},{"id":2204,"created":1666225010000,"updated":1666244179000,"title":"Australian VLab Centre of Excellence Regional Focus Group meeting, October 2022","titleNative":"Australian VLab Centre of Excellence Regional Focus Group meeting, October 2022","startDate":1666828800000,"endDate":1666828800000,"tbdDate":null,"city":"Melbourne","host":"Australian VLab Centre of Excellence","contactPerson":"Bodo Zeschke","contactEmail":"bodo.zeschke@bom.gov.au","contactUrl":"http://www.virtuallab.bom.gov.au/archive/regional-focus-group-recordings/","description":"Australian VLab Centre of Excellence Regional Focus Group meeting, scheduled for 27th October 2022. \nTopics of discussion as follows:\nCelebrating 9 years of the Austrlian VLab Centre of Excellence Regional Focus Group meetings. Session facilitated by Mr Bodo Zeschke, Australian Bureau of Meteorology Training Centre.\nHighlights of the Advancing Earth Observation Forum, Brisbane, August 2022. Session facilitated by Mr Bodo Zeschke, Australian Bureau of Meteorology Training Centre.\nAn update to the 12th Asia Oceania Meteorological Satellite User Conference Training Event. Session facilitated by Bodo Zeschke, Australian Bureau of Meteorology Training Centre with a contribution by Mr Takuya Sakashita Satellite Program Division, Information Infrastructure Department, Japan Meteorological Agency. \n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":null,"summary":null,"content":null,"targetAudience":"Meteorologists","registrationHowto":"We will be using Microsoft Teams Web Conferencing Software and the link to register is at https://teams.microsoft.com/registration/tX2t0d2XK0-BblDWY7e7lA,5WkBI5KjK0C45Ws29gOHyw,EEJWHDkhGUGkD5jhFcu4MQ,CqtYvS_MSUW2RzcWAFNIjA,XDK-CmiIPkuSv6OgKvNbCQ,TEliTubVjk27JjBsvLZpYA?mode=read&tenantId=d1ad7db5-97dd-4f2b-816e-50d663b7bb94 ","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5860,"name":"Bodo Zeschke","email":"bodo.zeschke@bom.gov.au","agency":"","country":"AU","programme":"","trainingPartner":{"id":5,"value":"VLab Centre of Excellence Australia"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":90,"value":"VLab","visible":true}],"trainingPartner":[{"id":5,"value":"VLab Centre of Excellence Australia","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":6,"value":"V South-West Pacific"}],"qualification":[{"id":21,"value":"Not Applicable"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2201,"created":1665700741000,"updated":1665745204000,"title":"Regional Focus Group of the Americas and the Caribbean - 15:00 UTC","titleNative":"Regional Focus Group of the Americas and the Caribbean - 15:00 UTC","startDate":1666796400000,"endDate":1666801800000,"tbdDate":null,"city":"Fort Collins","host":"CIRA + NOAA/WPC International Desks","contactPerson":"Bernie Connell","contactEmail":"bernie.connell@colostate.edu","contactUrl":"http://rammb.cira.colostate.edu/training/rmtc/focusgroup.asp","description":"These monthly weather and climate discussion sessions are bilingual (English and Spanish) and for WMO regions III (South America) and IV (Central America/Caribbean). Session time is 15:00 UTC; it will start 10 minutes earlier (14:50 UTC) for those who want to check their microphone and voice connection. GoToWebinar is used for both images and voice through the Internet.\nSatellite imagery shown during the session is from SLIDER: http://rammb-slider.cira.colostate.edu","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Use of GEO and LEO satellite imagery and products in real-time, review of significant weather events during the previous month, and interpretation of select climate indices in the short range.","summary":null,"content":null,"targetAudience":"Forecasters, Students, Researchers, Trainers","registrationHowto":"Register here: https://attendee.gotowebinar.com/register/6086631815263770384","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5859,"name":"Jose Galvez","email":"jose.galvez@colostate.edu","agency":"","country":"US","programme":"","trainingPartner":{"id":18,"value":"NOAA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":90,"value":"VLab","visible":true},{"id":210,"value":"NOAA","visible":true}],"trainingPartner":[{"id":12,"value":"VLab Centre of Excellence Costa Rica","visible":false},{"id":2,"value":"VLab Centre of Excellence Barbados","visible":false},{"id":3,"value":"VLab Centre of Excellence Argentina","visible":false},{"id":4,"value":"VLab Centre of Excellence Brazil","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":7,"value":"Spanish","iso639":"es"}],"regions":[{"id":3,"value":"III South America"},{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2128,"created":1644393580000,"updated":1693586463000,"title":"EUMeTrain Marine Course 2022","titleNative":"EUMeTrain Marine Course 2022","startDate":1666598400000,"endDate":1670587200000,"tbdDate":null,"city":"","host":"EUMeTrain","contactPerson":"Nuno Moreira, Carla Barroso","contactEmail":"nuno.moreira@ipma.pt, carla.barroso@eumetsat.int","contactUrl":"More info will soon be available.","description":"In 2013 EUMeTrain first organized its first Marine training course, using synchronous activities and supported by a Moodle platform. In 2015, 2017 and 2019 other editions of this course followed. The 5th Marine Satellite EUMeTrain Course will be held in 2022 in cooperation with EUMETSAT and EUMETCAL and, similarly to previous courses, will follow the Marine Weather Forecasters (MWF) Competence Requirements set by WMO.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"After completing the training, forecasters will be able to:\r\n\r\n- Maintain a weather watch over the marine weather situation, evolving significant weather phenomena and, where available, advisories issued by other meteorological services, and model guidance;\r\n- Compare current forecasts and warnings with observed conditions;\r\n- On the basis of the weather watch, appraise the need for amendments to forecasts and updates of warnings against established and documented criteria.\r\n- Analyse and diagnose the marine weather situation as required for the preparation and issue of forecasts;\r\n- Prepare forecasts for the following weather phenomena, parameters and variables, including spatial extent, onset and cessation, duration, intensity and temporal variations, where applicable: \r\ni)\tWind including directional variability, speed and wind gusts; \r\nii)\tSea state; \r\niii)\tDamaging large waves or multiple swell systems; \r\niv)\tHorizontal visibility due to fog, mist or precipitation\r\nv)\tSynoptic situation for tropical, subtropical, temperate and polar climate zones as required;\r\nvi)\tTropical cyclones, hurricanes, typhoons and their movement;\r\n\r\n- Ensure that forecasts are prepared and issued in accordance with the Manual on Marine Meteorological Services (WMO&#8209;No. 558), Volumes I and II.\r\n- Forecast and issue warning for the following hazardous weather phenomena, variables and parameters, including spatial extent, onset and cessation, duration, intensity and its temporal variations:\r\ni)\tTropical and extra-tropical cyclones, \r\nii)\tWind hazards; \r\niii)\tUnusual and hazardous wave conditions;\r\niv)\tRestricted visibility caused by fog or precipitation\r\nv)\tStorm-induced abnormal (sea) water levels;\r\n\r\n- Ensure that warning products are prepared and issued in accordance with thresholds for hazardous weather, as specified in the Manual on Marine Meteorological Services (WMO-No. 558), Volumes I and II.\r\n","summary":"In 2013 EUMeTrain first organized its first Marine training course, using synchronous activities and supported by a Moodle platform. In 2015, 2017 and 2019 other editions of this c","content":"The students will learn about:\r\n- Winds in the marine environment\r\n- Scatterometer wind observations\r\n- Ocean waves theory and model outputs\r\n- Altimeter ocean waves observations\r\n- Marine Fog\r\n- Severe marine weather conditions\r\n","targetAudience":"The primary audience is the community of operational marine weather forecasters across Europe. Knowledge is assumed in:\r\n- satellite image interpretation at the BIP-M level\r\n- ocean and atmospheric models at the BIP-M level\r\n- forecasting\r\n\r\nThe number of participants is limited to 25.","registrationHowto":"More info will soon be available on the EUMeTrain website.\r\nhttp://www.eumetrain.org","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5837,"name":"Mark Higgins","email":"mark.higgins@eumetsat.int","agency":"EUMETSAT","country":"EM","programme":"EUMETSAT","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":2,"value":"By invitation only"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":40,"value":"EUMeTrain","visible":true},{"id":50,"value":"EUMETSAT","visible":true}],"trainingPartner":[{"id":16,"value":"Eumetcal","visible":false},{"id":15,"value":"EUMETSAT","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":7,"value":"VI Europe"}],"qualification":[{"id":11,"value":"Marine: Marine Weather Forecaster"},{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2196,"created":1664908099000,"updated":1664912580000,"title":"Disaster Assessment Using Synthetic Aperture Radar","titleNative":"Disaster Assessment Using Synthetic Aperture Radar","startDate":1666191600000,"endDate":1666890000000,"tbdDate":null,"city":null,"host":"NASA Applied Remote Sensing Training Program (ARSET)","contactPerson":"Brock Blevins","contactEmail":"brock.blevins@nasa.gov","contactUrl":null,"description":"SAR sensors are ideal for monitoring certain disasters or areas that are vulnerable to disasters especially because the signal can “see” the surface of the Earth during day or night conditions and under nearly all weather conditions. In addition, the signal can penetrate through vegetation and is sensitive to surface roughness and small displacements of the land surface. This intermediate, three-part webinar series will focus on the use of SAR to 1) assess areas at risk from disasters due to landslides through the use of interferometric SAR (INSAR). This is accomplished by measuring small movements (on the order of centimeters) of the land surface that are caused by gradual landslide motion, and how these movements vary with time; 2) characterize the extent of oil spills and their impacts. SAR data is sensitive to surface roughness, allowing for identifying areas where there are oil spills; 3) and characterizing inundation extent. The SAR signal can penetrate through the vegetation and detect inundation driven by large precipitation events or by natural events. This training will include theoretical portions for each disaster as related to the SAR signal interaction with surface conditions and demonstrations using Google Earth Engine, Jupyter Notebooks, and the SNAP Toolbox, all freely and openly available tools.\n  \nRelevant UN Sustainable Development Goals: \n•\tGoal 11: Make cities and human settlements inclusive, safe, resilient and sustainable\n•\tTarget 11.5: By 2030, significantly reduce the number of deaths and the number of people affected and substantially decrease the direct economic losses relative to global gross domestic product caused by disasters, including water-related disasters, with a focus on protecting the poor and people in vulnerable situations\n•\tTarget 13.1: Strengthen resilience and adaptive capacity to climate-related hazards and natural disasters in all countries\n\nCourse Dates: October 19, 20, and 27, 2022\n \nTimes and Registration Information:  \n  \nEnglish Session: 11:00-13:00 EDT (UTC-4): https://go.nasa.gov/3BkK4S2\nSpanish Session: 14:00-16:00 EDT (UTC-4): https://go.nasa.gov/3KQBoWm\n \nCourse Format: Three, 2-hour parts\n \nRetweet option: https://twitter.com/NASAARSET/status/1571861920491048960\n \n \n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"By the end of this training attendees will be able to understand why SAR data is sensitive to inundation, oil spills, and landslides. They will also be able to use SAR data to monitor oil spills and floods as well as to identify areas at risk to landslides.","summary":null,"content":null,"targetAudience":"Disaster management agencies, including domestic and international government agencies (e.g., FEMA and equivalent government organizations outside the U.S.) as well as aid organizations (e.g. Red Cross, UN).","registrationHowto":"Course Dates: October 19, 20, and 27, 2022\n \nTimes and Registration Information:  \n  \nEnglish Session: 11:00-13:00 EDT (UTC-4): ","registrationEndDate":1666875600000,"fees":"No","awardGranted":null,"creator":{"id":25,"name":"Jochen Kerkmann","email":"jochen.kerkmann@web.de","agency":"EUMETSAT","country":"DE","programme":"EUMETSAT","trainingPartner":null,"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":120,"value":"NASA-ARSET","visible":true}],"trainingPartner":[{"id":25,"value":"NASA","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2192,"created":1663916278000,"updated":1693586463000,"title":"EUMeTrain Weather Briefing","titleNative":"EUMeTrain Weather Briefing","startDate":1666180800000,"endDate":1666184400000,"tbdDate":null,"city":null,"host":"EUMeTrain","contactPerson":"Marko Blaskovic","contactEmail":"blaskovic@cirus.dhz.hr","contactUrl":"http://eumetrain.org/weather_briefings.html","description":"Hosted by EUMeTrain, weather briefings are monthly online weather discussions about the phenomena that occurred over the past month, since the last weather briefing. Satellite imagery is used to discuss interesting situations and features. Every month the weather briefing is hosted by a different European country.\n\nWeather briefings are recorded. Find a collection of past briefings at http://eumetrain.org/briefings.html and on YouTube at https://www.youtube.com/user/eumetrain/videos.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutc