"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":null,"summary":null,"content":null,"targetAudience":null,"registrationHowto":"We will be using Microsoft Teams Web Conferencing Software and the link to register for the event is at https://events.teams.microsoft.com/event/bc5603c9-cf3f-4b6e-a7ac-a799ab63291d@d1ad7db5-97dd-4f2b-816e-50d663b7bb94  ","registrationEndDate":1734393600000,"fees":"No","awardGranted":null,"creator":{"id":5860,"name":"Bodo Zeschke","email":"bodo.zeschke@bom.gov.au","agency":"","country":"AU","programme":"","trainingPartner":{"id":5,"value":"VLab Centre of Excellence Australia"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":9959,"name":"Madalina System Admin Ungur ","email":"madalina.ungur@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":90,"value":"VLab","visible":true}],"trainingPartner":[{"id":20,"value":"JMA","visible":false}],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":6,"value":"V South-West Pacific"}],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2502,"created":1732649731000,"updated":1732653257000,"title":"Earth Observations of Blue Carbon Ecosystems","titleNative":"Earth Observations of Blue Carbon Ecosystems","startDate":1733238000000,"endDate":1733430600000,"tbdDate":null,"city":null,"host":"NASA Applied Remote Sensing Training Program (ARSET)","contactPerson":"Brock Blevins","contactEmail":"brock.blevins@nasa.gov","contactUrl":"https://appliedsciences.nasa.gov/get-involved/training/english/arset-earth-observations-blue-carbon-ecosystems?utm_source=direct&utm_medium=EUMETSAT-VLAB&utm_campaign=BlueCarbon24","description":"Nature-based climate solutions are an increasingly critical component of mitigating greenhouse gas emissions to meet the Paris Agreement goal of keeping temperature change to below 2-degrees Celsius. Blue carbon ecosystems, such as mangroves, salt marshes, and sea grasses, are a key aspect of nature-based climate solutions because of high carbon sequestration rates, long-term burial of carbon in sediments, potential for restoration, and connections to many additional ecosystem services.\n\nThis training builds from a series of previous trainings on Remote Sensing of Coastal Ecosystems, Remote Sensing of Mangroves, Remote Sensing of Greenhouse Gases, and Remote Sensing of Carbon Monitoring for Terrestrial Ecosystems to provide a comprehensive overview of blue carbon ecosystem remote sensing. The course will guide participants through mapping extent and quantifying the carbon stocks of blue carbon ecosystems using earth observations to support assessment, monitoring and restoration goals of these ecosystems.\n\nTwo, 1.5 hour parts including Q&A\n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"By the end of this training attendees will be able to:\n\n- Identify blue carbon ecosystems and the role they play in the global carbon budget\n- Map the extent of blue carbon ecosystems using satellite observations\n- Measure the carbon stock of mapped blue carbon ecosystems\n- Identify contexts in which earth observation data of carbon stocks in blue carbon ecosystems can inform reporting, monitoring, accounting and advocacy.\n","summary":null,"content":null,"targetAudience":"Local, regional, state, federal, foreign ministries and non-governmental organizations involved in coastal ecosystem management. Additionally, remote sensing practitioners, academics, and students looking to learn more about how to use remote sensing to assess blue carbon.","registrationHowto":"To Register: \nEnglish: 14:00-15:30 EST (UTC-5): https://go.nasa.gov/3TE7yKD\nFrench: 10:00-11:30 EST (UTC-5): https://go.nasa.gov/3BbQQMi\n","registrationEndDate":1733425200000,"fees":"No","awardGranted":null,"creator":{"id":5861,"name":"Brock Blevins","email":"brock.blevins@nasa.gov","agency":"","country":"US","programme":"","trainingPartner":{"id":25,"value":"NASA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":9959,"name":"Madalina System Admin Ungur ","email":"madalina.ungur@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":120,"value":"NASA-ARSET","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":4,"value":"French","iso639":"fr"}],"regions":[],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":1,"title":"Climate","identifier":"dataApplication"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":19,"title":"Data Applications","identifier":"dataApplication"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":12,"title":"Ocean biogeochemistry","identifier":"dataApplication"}],"eumDataAccessTypes":