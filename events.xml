atelliteMissions":[],"eumSensors":[]},{"id":1964,"created":1606470419000,"updated":1612532780000,"title":"The temperature of the sea surface (Basic) - Series of online short courses","titleNative":"The temperature of the sea surface (Basic) - Series of online short courses","startDate":1618401600000,"endDate":null,"tbdDate":null,"city":"","host":"EUMETSAT","contactPerson":"Lauren Biermann","contactEmail":"training@eumetsat.int","contactUrl":"https://training.eumetsat.int/course/view.php?id=401","description":"This course is part of the new edition of EUMETSAT series of online short courses on data discovery for weather, oceanography, air quality and climate running from January 2021. \r\n\r\nWe invite you to discover Global sea surface temperature data from the Instruments (SLSTR) onboard the Sentinel-3 satellites, including data access, visualization and processing. Tools will include Python, Jupyter Notebooks & SNAP.\r\n\r\nIn this short course you will learn:\r\n- What is meant by Sea Surface Temperature\r\n- Why the temperature of the ocean matters\r\n- How we measure ocean temperature from satellite\r\n\r\nWe will also demonstrate how you can access and work with sea surface temperature data provided by EUMETSAT using CODA and Python Jupyter Notebooks.\r\n\r\nA feedback session will start at 15:00 UTC. Both session will be recorded. \r\n\r\nTo get ready for the course, please visit https://training.eumetsat.int/course/view.php?id=401. ","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"","summary":"This course is part of the new edition of EUMETSAT series of online short courses on data discovery for weather, oceanography, air quality and climate running from January 2021. \r\n","content":"","targetAudience":"The short courses are open and address a wide range of attendees, from service providers scientists and forecasters.","registrationHowto":"Register in advance for this course at the course page:\r\nhttps://training.eumetsat.int/course/view.php?id=401.\r\n\r\nAfter registering, you will receive a confirmation email containing information about joining the webinar.","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":3925,"name":"Kim Hockley","email":"khock@pml.ac.uk","agency":"EUM","country":"GB","programme":"PML","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":50,"value":"EUMETSAT","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2016,"created":1615299324000,"updated":1615368119000,"title":"High Impact Weather Summer Course Webinar#1","titleNative":"High Impact Weather Summer Course Webinar#1","startDate":1618218000000,"endDate":null,"tbdDate":null,"city":"","host":"Eumetcal","contactPerson":"Eumetcal","contactEmail":"info@eumetcal.eu","contactUrl":"https://tinyurl.com/hiw2021webinar","description":"First webinar as part of High Impact Weather Summer Course.\r\n\r\nThis HIW course is an online course for EUMETCAL and will focus on the use of a particular forecasting method based on Doswells ingredient-based forecasting method  IBM (1996). This method assumes that three ingredients are needed for convection: moisture, lift, instability (and vertical wind shear to take the modes in convection into account).","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"1. Determine where and when deep conve