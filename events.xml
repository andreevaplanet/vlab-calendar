pes":[],"eumSatelliteMissions":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":2,"name":"MSG"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":3,"name":"MTG"}],"eumSensors":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":138,"name":"FCI","uniqueName":"FCI (MTG)"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":137,"name":"SEVIRI","uniqueName":"SEVIRI (MSG)"},{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":140,"name":"LI","uniqueName":"LI (MTG)"}]},{"id":2747,"created":1788895674000,"updated":1788896373000,"title":"Regional Focus Group of the Americas and the Caribbean - December 2026 Weather and Climate Discussion","titleNative":"Regional Focus Group of the Americas and the Caribbean - December 2026 Weather and Climate Discussion","startDate":1797436800000,"endDate":1797442200000,"tbdDate":null,"city":null,"host":"NOAA, CIRA, and CoEs: Costa Rica/Barbados/Argentina/Brazil","contactPerson":"Erin Sanders","contactEmail":"Erin.Sanders@colostate.edu","contactUrl":"https://rammb.cira.colostate.edu/training/rmtc/focusgroup/","description":"The monthly weather and climate discussions are bilingual (English and Spanish) and focus on WMO regions III (South America) and IV (Central America/Caribbean). The sessions highlight the use and interpretation of satellite imagery and products for meteorological applications, using SLIDER (http://rammb-slider.cira.colostate.edu) for imagery. Anyone with an interest is welcome to attend.\n\nGoToWebinar is the software platform used. The session will begin at 16:00 UTC, with the webinar opening 10 minutes earlier (15:50 UTC) for those who wish to check their microphone.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Satellite imagery and products real-time applications","summary":null,"content":null,"targetAudience":"Forecasters, Students, Researchers, Trainers","registrationHowto":"Register here: https://register.gotowebinar.com/register/7808020654287679837\n","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5874,"name":"Erin Sanders","email":"Erin.Sanders@colostate.edu","agency":"","country":"US","programme":"","trainingPartner":{"id":30,"value":"CIRA"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":5857,"name":"Zoya Andreeva","email":"zandreeva@wmo.int","agency":"","country":"CH","programme":"","trainingPartner":{"id":29,"value":"WMO"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":104,"value":"Discussion"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":90,"value":"VLab","visible":true},{"id":210,"value":"NOAA","visible":true},{"id":257,"value":"VLab Centre of Excellence Costa Rica","visible":true},{"id":267,"value":"VLab Centre of Excellence Barbados","visible":true},{"id":265,"value":"VLab Centre of Excellence Brazil","visible":true},{"id":266,"value":"VLab Centre of Excellence Argentina","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"},{"id":7,"value":"Spanish","iso639":"es"}],"regions":[{"id":3,"value":"III South America"},{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[{"id":17,"value":"Satellite Skills and Knowledge"}],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2762,"created":1791804614000,"updated":1791815512000,"title":"RGB Expert Community Workshop - Splinter meeting 2026","titleNative":"RGB Expert Community Workshop - Splinter meeting 2026","startDate":1796126400000,"endDate":1796137200000,"tbdDate":null,"city":"","host":"WMO","contactPerson":"Ivan Smiljanic","contactEmail":"ivan.smiljanic@external.eumesat.int","contactUrl":"https://community.wmo.int/site/knowledge-hub/programmes-and-initiatives/wmo-space-programme-wsp/rgb-workshops","description":"The WMO Splinter Workshop of the RGB Expert Community online gathering is intended as an intermediate event between two RGB workshops — the one held in Sweden in April 2025 and the next one tentatively planned for 2028.\n\nWe are looking for operational forecasters and RGB users to help us fine tune the existing FCI recipes. We are inviting operational users and developers working with FCI data, in any application area and from any corner of the globe, to join us to share their experience. In particular, we would be interested in hearing about the benefits and, more importantly, the possible limitations of the FCI RGBs currently used operationally in your environment, regardless of the specific recipe or tuning on which they are based.\n\nThe meeting will have a particular focus on the following two topics:\n\n1. User feedback on the current tunings of FCI RGBs, with the aim of identifying where a final refinement of selected FCI RGB composite tunings may be needed, including validation and/or further guidance for their operational implementation.\n\n2. A paper on the SEVIRI-to-FCI-to-FCI-v2 RGB tuning process and experience, to be submitted to the Atmospheric Measurement Techniques (AMT) special issue on MTG, with the aim of documenting the experience and providing guidance for similar future efforts (eg, the introduction of the GeoXO Imager (GXI) and the development of GXI RGB composites).\n\nAs EUMETSAT users transition from SEVIRI to the next-generation Flexible Combined Imager (FCI), the adaptation of RGB composite recipes has become a key priority. While initial RGB tunings for the FCI instrument are now in place, operational experience shows that there is still room for improvement (substantial in the case of some RGBs). \n","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"","summary":"The WMO Splinter Workshop of the RGB Expert Community with highlight on the fine-tuning of FCI RGB recipes. ","content":null,"targetAudience":"Experts, trainers, and operational users of RGB composites. ","registrationHowto":"Use [this form](https://forms.cloud.microsoft/e/kusXTbCEtg) to express your interest.\n","registrationEndDate":1792713540000,"fees":"No","awardGranted":null,"creator":{"id":5845,"name":"Ivan Smiljanic","email":"ivan.smiljanic@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":9959,"name":"Madalina System Admin Ungur ","email":"madalina.ungur@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":103,"value":"Workshop"},"attendance":{"id":2,"value":"By invitation only"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":50,"value":"EUMETSAT","visible":true},{"id":100,"value":"WMO","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":2,"value":"II Asia"},{"id":3,"value":"III South America"},{"id":6,"value":"V South-West Pacific"},{"id":7,"value":"VI Europe"},{"id":1,"value":"I Africa"},{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":19,"title":"Data Applications","identifier":"dataApplication"}],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2763,"created":1791885863000,"updated":1792509918000,"title":"CAN in Practice: Questions, Feedback and What's Next","titleNative":"CAN in Practice: Questions, Feedback and What's Next","startDate":1795694400000,"endDate":1795698000000,"tbdDate":null,"city":null,"host":null,"contactPerson":"Christine Traeger Chatterjee","contactEmail":"training@eumetsat.int","contactUrl":null,"description":"\nThe Climate Anomalies and Normals (CAN) Service is a web-based platform facilitating the exploration of satellite-based climate normals and anomalies. The data can be displayed as interactive maps or graphs of time series, and can be downloaded for further analyses.\n\nThe webinar will introduce the main functionalities of the Climate Anomalies and Normals (CAN) Service. We will start with a short demonstration and then focus on participants' questions.\n\nParticipants are encouraged to engage with the CAN Service prior to the webinar at can.eumetsat.int.\nA [description of the CAN Service and its functionalities](https://user.eumetsat.int/resources/user-guides/climate-anomalies-and-normals-can-service-user-guide) is available in the EUMETSAT User Portal.\n\nThe webinar will be run on Zoom, supported by Slido to manage the interaction with participants.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"After the webinar, participants will be able to:\n* Create and download maps of the products provided via the CAN service for a region of interest.\n* Create and download time-series of anomalies provided via the CAN service.\n* Download the data provided via the CAN service for a defined region and a defined period of time.\n* Discuss the advantages of the CAN service.\n* Discuss future evolutions of the CAN service.\n\n\n\n","summary":"This webinar introduces and discusses the functionalities of the EUMETSAT Climate Anomalies and Normals (CAN) Service.","content":null,"targetAudience":"1. Users in Climate Services\n2. Data Scientists, journalists with climate competence\n3. Students in Earth Sciences, and the wider interested public","registrationHowto":"To join the webinar, please [register](https://eumetsat.zoom.us/webinar/register/WN_pxQSuxOaTgyoYcEKrnDG7A). ","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":13310,"name":"Antonio Vecoli","email":"Antonio.Vecoli@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":null,"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":9959,"name":"Madalina System Admin Ungur ","email":"madalina.ungur@external.eumetsat.int","agency":"","country":"EM","programme":"","trainingPartner":{"id":15,"value":"EUMETSAT"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":107,"value":"Webinar"},"attendance":null,"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":241,"value":"OSI SAF","visible":true},{"id":247,"value":"H SAF","visible":true},{"id":226,"value":"CM SAF","visible":true},{"id":50,"value":"EUMETSAT","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[],"qualification":[{"id":9,"value":"Climate Services: Provision of Climate Services"}],"eumDataApplications":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":1,"title":"Climate","identifier":"dataApplication"}],"eumDataAccessTypes":[{"eventMetadataGroup":{"id":1,"name":"EUMETSAT"},"id":25,"name":"CAN"}],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2741,"created":1787227382000,"updated":1787239479000,"title":"ASMET16 - MTG Resource Development Workshop for Africa","titleNative":"ASMET16 -