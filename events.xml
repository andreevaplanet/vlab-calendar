":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":true,"initiative":[{"id":50,"value":"EUMETSAT","visible":true},{"id":80,"value":"Other","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":7,"value":"VI Europe"}],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":335,"created":null,"updated":null,"title":"CIMH Aeronautical Professional Development Course","titleNative":"CIMH Aeronautical Professional Development Course","startDate":1380240000000,"endDate":1398988800000,"tbdDate":"","city":"Caribbean","host":"CIMH","contactPerson":"Kathy-Ann Caesar","contactEmail":"kacaesar@cimh.edu.bb","contactUrl":"http://cimh.edu.bb/?p=training&c=meteorology","description":"CIMH Aeronautical Continuing Professional Development  Course for Aeronautical forecasters\r\n\r\nThe goal of this course is to provide material, course work and techniques to aid Aeronautical forecasters to meet the recommended WMO Commission on Aeronautical Meteorology (CAeM) Competencies.  The Aeronautical Forecaster Competencies must be met by December, 2013. These defined competencies describe much of the knowledge and skills also identified as critical outcomes of the Basic Instructional Package for Meteorologists (BIP-M), and which becomes a mandatory requirement for aeronautical personnel in 2016. \r\n\r\nBy the end of this course, graduates should be able to:\r\n\r\n    Demonstrate an understanding of tropical meteorology and its complexities;\r\n    Use satellite imagery to identify and diagnose various tropical systems;\r\n    Interpret radar imagery in the tropics including Doppler imagery;\r\n    Utilize mesoscale NWP model outputs in the forecast process; and\r\n    Apply their knowledge and relevant tools to operational aeronautical duties.\r\n\r\nBy completing this course, participants will ensure they are competent within the field of aeronautical meteorology, as recommended by WMO Annex II.  Participants will also learn how to use tools that will aid with achieving WMO EC-LXII (2010) approved Aeronautical Meteorological Personnel Competence Standards for an Aeronautical Meteorological Forecaster","country":null,"learningOutcome":"","summary":null,"content":"","targetAudience":"Not defined","registrationHowto":"","registrationEndDate":null,"fees":"","awardGranted":null,"creator":{"id":5869,"name":"Kathy-Ann Caesar ","email":"kacaesar@cimh.edu.bb","agency":"","country":"BB","programme":"","trainingPartner":{"id":2,"value":"VLab Centre of Excellence Barbados"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":null,"leadTrainer":null,"aclGroup":{"id":2,"name":"EUMETSAT"},"statusUpdate":null,"eventType":{"id":101,"value":"Course"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":"DEFINITE","format":null,"attendeeCount":0,"external":false,"previouslyConfirmed":true,"initiative":[{"id":70,"value":"NHMS","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":4,"value":"IV North America, Central America and Caribbean"}],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":333,"created":null,"updated":null,"title":"Virtual Round Table on Aeronautical Meteorological Competences - Second Session - French","titleNative":"Virtual Round Table on Aeronautical Meteorological Competences - Second Session - French","startDate":1380153600000,"endDate":1380153600000,"tbdDate":"","city":"Online","host":"EAMAC","contactPerson":"Lu Veeck","contactEmail":"luveeck@googlemail.com","contactUrl":"http://mt204.sabameeting.com/main/Customers/fmi/Registrar/NewRegistration.jsp?event_id=0000002dd444110140d70156b60079bd&source=","description