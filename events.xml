e@d1ad7db5-97dd-4f2b-816e-50d663b7bb94 ","registrationEndDate":null,"fees":"No","awardGranted":null,"creator":{"id":5860,"name":"Bodo Zeschke","email":"bodo.zeschke@bom.gov.au","agency":"","country":"AU","programme":"","trainingPartner":{"id":5,"value":"VLab Centre of Excellence Australia"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":5857,"name":"Zoya Andreeva","email":"zandreeva@wmo.int","agency":"","country":"CH","programme":"","trainingPartner":{"id":29,"value":"WMO"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"leadTrainer":null,"aclGroup":{"id":3,"name":"VLAB"},"statusUpdate":null,"eventType":{"id":108,"value":"Meeting"},"attendance":{"id":1,"value":"Open"},"status":{"id":2,"value":"Confirmed"},"condition":null,"format":"ONLINE","attendeeCount":0,"external":false,"previouslyConfirmed":false,"initiative":[{"id":264,"value":"VLab Centre of Excellence Australia","visible":true}],"trainingPartner":[],"programmes":[],"language":[{"id":3,"value":"English","iso639":"en"}],"regions":[{"id":6,"value":"V South-West Pacific"}],"qualification":[],"eumDataApplications":[],"eumDataAccessTypes":[],"eumSatelliteMissions":[],"eumSensors":[]},{"id":2666,"created":1766520727000,"updated":1766559739000,"title":"Geostationary Remote Sensing of Trace Gases for Air Quality Applications in North America","titleNative":"Geostationary Remote Sensing of Trace Gases for Air Quality Applications in North America","startDate":1768924800000,"endDate":1769203800000,"tbdDate":null,"city":null,"host":"NASA Applied Remote Sensing Training Program (ARSET)","contactPerson":"Brock Blevins","contactEmail":"brock.blevins@nasa.gov","contactUrl":"https://www.earthdata.nasa.gov/learn/trainings/geostationary-remote-sensing-trace-gases-air-quality-applications-north-america","description":"The Tropospheric Emissions: Monitoring of POllution (TEMPO) mission is the first space-based instrument to continuously measure daytime air quality over North America, from the Atlantic Ocean to the Pacific and from Central Canada to Mexico City. These data are essential for understanding diurnal changes in air quality and monitoring real-time movement of pollutant plumes, such as wildfire smoke and urban emissions. This training, led by NASA's Applied Remote Sensing Training Program (ARSET), will provide an overview of TEMPO capabilities and available trace gas data products, and illustrate how TEMPO data can be visualized using NASA Worldview online. These capabilities will be demonstrated through hands-on exercises where participants will look at TEMPO data events and learn how to interpret TEMPO observations to better understand the scope and potential air quality impact of these types of hazards.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"By the end of this training attendees will be able to:\n\nDescribe the basic characteristics of TEMPO and its benefits and limitations compared to other air-quality-relevant missions and instruments\n\nIdentify available trace gas data products from TEMPO and their associated characteristics\n\nVisualize hourly TEMPO trace gas data products using NASA Worldview for current and historical events\n\nEvaluate TEMPO trace gas products in Worldview to anticipate short-term air quality risks, such as high concentrations of ozone precursors\n\nDistinguish uses for TEMPO trace gas data products given cloud and solar zenith angle thresholds\n\nDetermine the spatial patterns, temporal trends, and likely sources of trace gases related to wildfire smoke and urban area air pollution events using TEMPO data via Worldview","summary":null,"content":null,"targetAudience":"North American air quality managers within the TEMPO field of regard\nAir quality scientists","registrationHowto":"Click this link to register for the training: https://go.