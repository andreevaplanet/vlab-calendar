ail":"eumetrain@gmail.com","contactUrl":"https://resources.eumetrain.org/events/260508_Invitation_Letter_Advanced_Satellite_Course_2026.pdf","description":"The course focuses on deepening specialist knowledge of satellite meteorology, particularly the use of MTG imagery and products in combination with NWP and other meteorological data. Key subject areas include weather phenomena over the Mediterranean, the westerly wind zone, and Northern Europe, with case studies on wild fires, Storm Amy, and polar lows.\n\nThe training is conducted as blended training. Participants will engage in three hours of online work per week, including brief playground sessions, and will attend a four‑day in‑person block to consolidate learning. Learning objectives are to enhance satellite meteorology expertise, improve practical application of MTG data in operational forecasting, and exchange of working methods across weather services. Prerequisites are basic synoptic meteorology, hands‑on forecasting experience, and familiarity with MTG images.","country":{"id":"--","name":"ONLINE","region":null,"type":"Other"},"learningOutcome":"Deepening specialist knowledge in satellite meteorology with focus on MTG combined with other meteorological products (WMO Skills). ","summary":null,"content":null,"targetAudience":"European forecasters in the field of aviation or general meteorology.","registrationHowto":"Access the registration for the Advanced Satellite Course in the [link](https://forms.cloud.microsoft/e/VqKHL5iY2F).","registrationEndDate":1783123140000,"fees":null,"awardGranted":null,"creator":{"id":12935,"name":"Ana Fazinic","email":"ana.fazinic@dhz.hr","agency":"","country":"HR","programme":"","trainingPartner":{"id":17,"value":"EuMeTrain"},"userIdentifier":null,"blocked":null,"lastAccess":null,"webGroup":null,"profile":null,"aclRoleIds":null,"aclGroupIds":null},"approver":{"id":9959,"name":"Madalina System Admin Ungur ","email":"madalina.ungur@external.eumetsat.int","agency":"","country"